import type {
  Metadata,
} from "next";

import {
  ClerkProvider,
} from "@clerk/nextjs";

import "./globals.css";

const siteName =
  "The Under Over Club";

const siteUrl =
  "https://theunderoverclub.com";

const siteDescription =
  "Daily football predictions with two free O/U 2.5 picks, members-only value picks, and transparent real-result performance statistics.";

export const metadata:
  Metadata = {
    metadataBase:
      new URL(siteUrl),

    applicationName:
      siteName,

    title: {
      default:
        "The Under Over Club | Football Picks & Statistics",
      template:
        "%s | The Under Over Club",
    },

    description:
      siteDescription,

    keywords: [
      "football picks",
      "football predictions",
      "over 2.5 goals",
      "under 2.5 goals",
      "BTTS",
      "football statistics",
      "football value picks",
    ],

    category:
      "sports",

    alternates: {
      canonical: "/",
    },

    openGraph: {
      type: "website",
      locale: "en_GB",
      url: "/",
      siteName,
      title:
        "The Under Over Club",
      description:
        "Stats. Goals. Profit. Two free O/U 2.5 football picks every day, a members-only value board, and transparent real-result statistics.",
      images: [
        {
          url:
            "/opengraph-image",
          width: 1200,
          height: 630,
          alt:
            "The Under Over Club — Stats. Goals. Profit.",
        },
      ],
    },

    twitter: {
      card:
        "summary_large_image",
      title:
        "The Under Over Club",
      description:
        "Two free O/U 2.5 football picks every day, members-only value picks, and transparent statistics.",
      images: [
        "/opengraph-image",
      ],
    },

    robots: {
      index: true,
      follow: true,
      googleBot: {
        index: true,
        follow: true,
        "max-image-preview":
          "large",
        "max-snippet": -1,
        "max-video-preview": -1,
      },
    },

    icons: {
      icon: [
        {
          url: "/icon.svg",
          type:
            "image/svg+xml",
        },
      ],
      shortcut:
        "/icon.svg",
    },
  };

export default function RootLayout({
  children,
}: Readonly<{
  children:
    React.ReactNode;
}>) {
  return (
    <html lang="en">
      <body>
        <ClerkProvider
          afterSignOutUrl="/"
        >
          {children}
        </ClerkProvider>
      </body>
    </html>
  );
}
