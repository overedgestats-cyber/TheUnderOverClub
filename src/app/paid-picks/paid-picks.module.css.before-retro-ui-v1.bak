.page {
  min-height: 100vh;
  background: #050807;
  color: #f2f6f3;
}

.shell {
  width: min(1180px, calc(100% - 24px));
  margin: 0 auto;
  padding: 24px 0 48px;
}

.topbar,
.hero,
.card,
.empty {
  border: 1px solid #29372f;
  background: #090e0b;
  box-shadow: 6px 6px 0 #020302;
}

.topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 18px;
  padding: 14px 16px;
}

.brand {
  color: #6bf39c;
  text-decoration: none;
  font-size: 12px;
  font-weight: 900;
  letter-spacing: .14em;
}

.nav {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}

.nav a {
  color: #7d8982;
  text-decoration: none;
  font-size: 10px;
  font-weight: 900;
  letter-spacing: .08em;
  padding: 8px 10px;
}

.nav .active {
  color: #6bf39c;
  border: 1px solid #2e6945;
  background: #0d1b13;
}

.hero {
  margin-top: 22px;
  padding: 28px;
}

.hero > span {
  color: #6bf39c;
  font-size: 10px;
  font-weight: 900;
  letter-spacing: .14em;
}

.hero h1 {
  margin: 8px 0;
  font-size: clamp(40px, 7vw, 68px);
}

.hero p {
  margin: 0;
  max-width: 650px;
  color: #849188;
}

.grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18px;
  margin-top: 22px;
}

.card {
  padding: 20px;
}

.cardTop {
  display: flex;
  justify-content: space-between;
  color: #6bf39c;
  font-size: 11px;
  font-weight: 900;
}

.card small {
  display: block;
  margin: 18px 0;
  color: #79857e;
}

.card h2 {
  margin: 0;
  font-size: 28px;
}

.vs {
  margin: 6px 0;
  color: #5f6b64;
  font-size: 10px;
  font-weight: 900;
}

.pick {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  margin-top: 22px;
  padding: 14px;
  border: 1px solid #326448;
  background: #0b1b12;
}

.pick span {
  color: #748078;
  font-size: 11px;
  font-weight: 900;
}

.pick strong {
  color: #70f4a0;
  font-size: 21px;
}

.metrics {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  margin-top: 16px;
  border: 1px solid #202a24;
}

.metrics div {
  padding: 12px;
}

.metrics div + div {
  border-left: 1px solid #202a24;
}

.metrics span {
  display: block;
  color: #66726b;
  font-size: 9px;
  font-weight: 900;
  margin-bottom: 7px;
}

.metrics strong {
  font-size: 17px;
}

.empty {
  margin-top: 22px;
  padding: 26px;
  color: #849188;
}

@media (max-width: 760px) {
  .topbar {
    align-items: flex-start;
    flex-direction: column;
  }

  .grid {
    grid-template-columns: 1fr;
  }

  .metrics {
    grid-template-columns: repeat(2, 1fr);
  }

  .metrics div:nth-child(3) {
    border-left: 0;
    border-top: 1px solid #202a24;
  }

  .metrics div:nth-child(4) {
    border-top: 1px solid #202a24;
  }
}
