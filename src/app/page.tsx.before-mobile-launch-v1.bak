import Link from "next/link";
import {
  auth,
} from "@clerk/nextjs/server";

import {
  getPublicFreePicks,
} from "@/lib/free-picks/public-free-picks";
import {
  getCombinedStatistics,
} from "@/lib/statistics/recommendation-statistics";

import styles from "./home.module.css";

export const dynamic =
  "force-dynamic";
export const revalidate =
  0;

type AnyRecord =
  Record<
    string,
    any
  >;

function numberValue(
  value: unknown,
  fallback = 0,
) {
  const parsed =
    Number(value);

  return Number.isFinite(
    parsed,
  )
    ? parsed
    : fallback;
}

function stringValue(
  value: unknown,
  fallback = "",
) {
  return typeof value ===
    "string"
    ? value
    : fallback;
}

function formatPercent(
  value: unknown,
) {
  return `${numberValue(
    value,
  ).toFixed(1)}%`;
}

function formatUnits(
  value: unknown,
) {
  const number =
    numberValue(value);

  return `${number >= 0 ? "+" : ""}${number.toFixed(
    2,
  )}`;
}

function pickSelection(
  pick:
    AnyRecord,
) {
  const raw =
    stringValue(
      pick.selection ??
        pick.pick,
    );

  const normalized =
    raw.toLowerCase();

  if (
    normalized ===
      "over_2_5" ||
    normalized ===
      "over 2.5"
  ) {
    return "Over 2.5";
  }

  if (
    normalized ===
      "under_2_5" ||
    normalized ===
      "under 2.5"
  ) {
    return "Under 2.5";
  }

  return raw || "O/U 2.5";
}

function pickTeams(
  pick:
    AnyRecord,
) {
  const home =
    stringValue(
      pick.home ??
        pick.homeTeam ??
        pick.home_name,
      "Home",
    );

  const away =
    stringValue(
      pick.away ??
        pick.awayTeam ??
        pick.away_name,
      "Away",
    );

  return {
    home,
    away,
  };
}

