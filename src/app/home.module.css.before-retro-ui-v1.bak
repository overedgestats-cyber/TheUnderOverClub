.page {
  --bg: #030806;
  --panel: #07100b;
  --panel-2: #09150e;
  --line: #20392b;
  --line-strong: #2c6846;
  --green: #6dff9e;
  --green-dim: #2ecb65;
  --white: #f1f5f2;
  --muted: #87958d;
  --yellow: #f0de63;

  min-height: 100vh;
  overflow-x: hidden;
  position: relative;
  background:
    radial-gradient(
      circle at 70% 0%,
      rgba(29, 116, 61, 0.13),
      transparent 34%
    ),
    var(--bg);
  color: var(--white);
}

.gridNoise {
  position: fixed;
  inset: 0;
  pointer-events: none;
  opacity: 0.2;
  background-image:
    linear-gradient(
      rgba(255,255,255,0.025) 1px,
      transparent 1px
    ),
    linear-gradient(
      90deg,
      rgba(255,255,255,0.025) 1px,
      transparent 1px
    );
  background-size: 16px 16px;
  mask-image:
    linear-gradient(
      to bottom,
      rgba(0,0,0,1),
      rgba(0,0,0,0.18)
    );
}

.shell {
  position: relative;
  z-index: 1;
  width: min(1480px, calc(100% - 40px));
  margin: 0 auto;
  padding: 24px 0 42px;
}

.header {
  min-height: 76px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  padding: 0 22px;
  border: 1px solid var(--line);
  background: rgba(5, 13, 9, 0.94);
  box-shadow: 8px 8px 0 rgba(0,0,0,0.4);
}

.brand {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  color: var(--green);
  text-decoration: none;
  font-size: 13px;
  font-weight: 900;
  letter-spacing: 0.14em;
}

.brandMark {
  width: 34px;
  height: 34px;
  display: grid;
  place-items: center;
  border: 1px solid var(--green-dim);
  background: #0a2214;
  font-size: 10px;
  box-shadow:
    3px 3px 0 #020402;
}

.nav {
  display: flex;
  align-items: center;
  gap: 4px;
}

.nav a {
  padding: 13px 15px;
  border: 1px solid transparent;
  color: var(--muted);
  text-decoration: none;
  font-size: 11px;
  font-weight: 900;
  letter-spacing: 0.08em;
}

.nav a:hover,
.navAccent {
  border-color: var(--line-strong) !important;
  color: var(--green) !important;
  background: #0a1b11;
}

.hero {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(420px, 0.86fr);
  gap: 24px;
  min-height: 620px;
  margin-top: 26px;
}

.heroCopy {
  padding: 62px 50px 52px;
  border: 1px solid var(--line);
  background:
    linear-gradient(
      145deg,
      rgba(18, 48, 28, 0.6),
      rgba(4, 10, 7, 0.97) 50%
    );
  box-shadow: 10px 10px 0 rgba(0,0,0,0.46);
}

.eyebrow,
.kicker {
  color: var(--green);
  font-size: 11px;
  font-weight: 900;
  letter-spacing: 0.14em;
}

.hero h1 {
  margin: 26px 0 22px;
  font-size: clamp(64px, 8vw, 126px);
  line-height: 0.83;
  letter-spacing: -0.055em;
}

.hero h1 span {
  color: var(--green);
}

.heroCopy > p {
  max-width: 650px;
  margin: 0;
  color: #a3afa8;
  font-size: clamp(16px, 1.6vw, 22px);
  line-height: 1.6;
}

.heroActions {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 32px;
}

.primaryButton,
.secondaryButton {
  display: inline-flex;
  justify-content: center;
  align-items: center;
  min-height: 52px;
  padding: 0 22px;
  text-decoration: none;
  font-size: 11px;
  font-weight: 900;
  letter-spacing: 0.08em;
}

.primaryButton {
  border: 1px solid var(--green);
  background: #0e2a19;
  color: var(--green);
  box-shadow:
    4px 4px 0 #020402;
}

.secondaryButton {
  border: 1px solid #3c4b42;
  background: #080e0a;
  color: var(--white);
}

.primaryButton:hover,
.secondaryButton:hover {
  transform:
    translate(2px, 2px);
  box-shadow: none;
}

.heroMeta {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 34px;
}

.heroMeta span,
.marketChips span {
  padding: 9px 11px;
  border: 1px solid var(--line);
  background: #07100b;
  color: #92a198;
  font-size: 9px;
  font-weight: 900;
  letter-spacing: 0.08em;
}

.pixelStadium {
  position: relative;
  overflow: hidden;
  min-height: 620px;
  border: 1px solid var(--line);
  background:
    linear-gradient(
      to bottom,
      #07140c 0%,
      #07140c 22%,
      #0a1c11 22%,
      #0a1c11 48%,
      #07100b 48%,
      #07100b 100%
    );
  box-shadow: 10px 10px 0 rgba(0,0,0,0.46);
}

.scoreboard {
  position: absolute;
  z-index: 5;
  top: 46px;
  left: 50%;
  width: 190px;
  transform: translateX(-50%);
  padding: 15px 16px;
  border: 2px solid #326946;
  background: #020604;
  text-align: center;
  box-shadow:
    5px 5px 0 #000;
}

.scoreboard span {
  display: block;
  color: #769080;
  font-size: 9px;
  font-weight: 900;
  letter-spacing: 0.12em;
}

.scoreboard strong {
  display: block;
  margin-top: 5px;
  color: var(--green);
  font-size: 15px;
  letter-spacing: 0.07em;
}

.floodlightLeft,
.floodlightRight {
  position: absolute;
  top: 14px;
  width: 18px;
  height: 240px;
  background:
    repeating-linear-gradient(
      to bottom,
      #314b3a 0 8px,
      #132219 8px 16px
    );
}

.floodlightLeft {
  left: 38px;
}

.floodlightRight {
  right: 38px;
}

.floodlightLeft::before,
.floodlightRight::before {
  content: "";
  position: absolute;
  top: 0;
  width: 72px;
  height: 38px;
  border: 2px solid #456650;
  background:
    repeating-linear-gradient(
      90deg,
      #d4ffe1 0 7px,
      #78c48f 7px 13px
    );
  box-shadow:
    0 0 30px rgba(109,255,158,0.18);
}

.floodlightLeft::before {
  left: -27px;
}

.floodlightRight::before {
  right: -27px;
}

.stand {
  position: absolute;
  inset: 190px 0 auto;
  height: 190px;
  border-top: 5px solid #0f2b19;
  border-bottom: 5px solid #0f2b19;
  background:
    repeating-linear-gradient(
      to bottom,
      #0b1910 0 23px,
      #07100b 23px 29px
    );
}

.crowd,
.crowdSecond {
  position: absolute;
  inset: 18px 15px auto;
  height: 56px;
  opacity: 0.7;
  background:
    repeating-linear-gradient(
      90deg,
      #5d7d69 0 4px,
      transparent 4px 8px,
      #315b40 8px 12px,
      transparent 12px 17px
    );
}

.crowdSecond {
  top: 98px;
  opacity: 0.5;
}

.pitch {
  position: absolute;
  left: 6%;
  right: 6%;
  bottom: 28px;
  height: 220px;
  border: 4px solid #6a9d76;
  background:
    repeating-linear-gradient(
      90deg,
      #0d4b24 0 58px,
      #105a2a 58px 116px
    );
  transform: perspective(520px) rotateX(54deg);
  transform-origin: bottom;
}

.pitchLine {
  position: absolute;
  left: 50%;
  top: 0;
  bottom: 0;
  width: 3px;
  background: #87b990;
}

.centerCircle {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 90px;
  height: 90px;
  transform: translate(-50%, -50%);
  border: 3px solid #87b990;
  border-radius: 50%;
}

.goalLeft,
.goalRight {
  position: absolute;
  top: 50%;
  width: 52px;
  height: 110px;
  transform: translateY(-50%);
  border: 3px solid #87b990;
}

.goalLeft {
  left: -3px;
  border-left: 0;
}

.goalRight {
  right: -3px;
  border-right: 0;
}

.ball {
  position: absolute;
  left: 68%;
  top: 57%;
  width: 12px;
  height: 12px;
  background: #f6f8f6;
  box-shadow:
    3px 0 0 #1f3125,
    -3px 0 0 #1f3125,
    0 3px 0 #1f3125;
}

.section {
  margin-top: 26px;
  padding: 28px;
  border: 1px solid var(--line);
  background: rgba(5, 13, 9, 0.94);
  box-shadow: 8px 8px 0 rgba(0,0,0,0.38);
}

.sectionHeading {
  display: flex;
  justify-content: space-between;
  align-items: end;
  gap: 24px;
  margin-bottom: 22px;
}

.sectionHeading h2,
.paidCopy h2 {
  margin: 8px 0 0;
  font-size: clamp(32px, 4vw, 56px);
  font-weight: 500;
  letter-spacing: -0.04em;
}

.sectionDate,
.textLink {
  color: #9cad9f;
  font-size: 11px;
  font-weight: 900;
  letter-spacing: 0.08em;
  text-decoration: none;
}

.pickGrid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18px;
}

.pickCard {
  overflow: hidden;
  border: 1px solid var(--line);
  background: #07100b;
  box-shadow:
    6px 6px 0 #020402;
}

.pickCard::before {
  content: "";
  display: block;
  width: 86px;
  height: 4px;
  background: var(--green);
}

.pickTop,
.competition,
.teams,
.selection {
  padding-left: 22px;
  padding-right: 22px;
}

.pickTop {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 18px;
  color: var(--green);
  font-size: 10px;
  font-weight: 900;
  letter-spacing: 0.08em;
}

.pending {
  padding: 7px 9px;
  border: 1px solid #675b13;
  background: #171405;
  color: var(--yellow);
}

.competition {
  margin-top: 10px;
  color: #718077;
  font-size: 9px;
  font-weight: 900;
  letter-spacing: 0.08em;
}

.teams {
  display: grid;
  gap: 4px;
  padding-top: 28px;
  padding-bottom: 28px;
}

.teams strong {
  font-size: clamp(24px, 3vw, 40px);
  font-weight: 500;
}

.teams span {
  color: #657268;
  font-size: 10px;
  font-weight: 900;
}

.selection {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
  margin: 0 22px 22px;
  padding: 22px !important;
  border: 1px solid #2b6642;
  background: #0a1c11;
}

.selection span {
  color: #718077;
  font-size: 10px;
  font-weight: 900;
  letter-spacing: 0.08em;
}

.selection strong {
  color: var(--green);
  font-size: 26px;
}

.pickMetrics {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  border-top: 1px solid var(--line);
}

.pickMetrics div {
  padding: 16px 20px 18px;
}

.pickMetrics div + div {
  border-left: 1px solid var(--line);
}

.pickMetrics span,
.statCard span {
  display: block;
  color: #748279;
  font-size: 9px;
  font-weight: 900;
  letter-spacing: 0.1em;
}

.pickMetrics strong {
  display: block;
  margin-top: 7px;
  font-size: 22px;
}

.sectionFooter {
  display: flex;
  justify-content: space-between;
  gap: 20px;
  margin-top: 18px;
  color: #647268;
  font-size: 9px;
  font-weight: 900;
  letter-spacing: 0.08em;
}

.sectionFooter a {
  color: var(--green);
  text-decoration: none;
}

.emptyState {
  display: flex;
  align-items: center;
  gap: 18px;
  padding: 28px;
  border: 1px solid var(--line);
  background: #07100b;
}

.emptyIcon {
  width: 56px;
  height: 56px;
  display: grid;
  place-items: center;
  border: 1px solid #31563e;
  color: var(--green);
  font-size: 14px;
  font-weight: 900;
}

.emptyState strong {
  display: block;
  font-size: 18px;
}

.emptyState p {
  margin: 6px 0 0;
  color: var(--muted);
}

.statsGrid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14px;
}

.statCard {
  min-height: 150px;
  padding: 22px;
  border: 1px solid var(--line);
  background: #07100b;
}

.statCard strong {
  display: block;
  margin-top: 18px;
  font-size: clamp(30px, 4vw, 46px);
}

.statCard small {
  display: block;
  margin-top: 12px;
  color: #6f7d74;
  font-size: 10px;
}

.liveRecord {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-top: 16px;
  color: var(--green);
  font-size: 9px;
  font-weight: 900;
  letter-spacing: 0.08em;
}

.liveRecord > span:last-child {
  margin-left: auto;
  color: #6d7b72;
}

.liveDot {
  width: 8px;
  height: 8px;
  background: var(--green);
  box-shadow: 0 0 12px rgba(109,255,158,0.5);
}

.paidSection {
  display: grid;
  grid-template-columns: minmax(0, 1.1fr) minmax(380px, 0.9fr);
  gap: 18px;
  margin-top: 26px;
}

.paidCopy,
.pricePanel {
  border: 1px solid var(--line);
  background: #07100b;
  box-shadow: 8px 8px 0 rgba(0,0,0,0.38);
}

.paidCopy {
  padding: 36px;
}

.paidCopy p {
  max-width: 700px;
  color: var(--muted);
  line-height: 1.7;
}

.marketChips {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin: 22px 0 26px;
}

.pricePanel {
  padding: 26px;
}

.priceTop {
  padding: 24px;
  border: 1px solid #2f6f46;
  background: #0b2013;
}

.priceTop span,
.priceTop small {
  display: block;
  color: var(--green);
  font-size: 9px;
  font-weight: 900;
  letter-spacing: 0.1em;
}

.priceTop strong {
  display: block;
  margin: 8px 0 2px;
  font-size: 58px;
}

.priceRows {
  margin-top: 12px;
}

.priceRows div {
  display: flex;
  justify-content: space-between;
  padding: 15px 4px;
  border-bottom: 1px solid var(--line);
  color: #91a097;
  font-size: 11px;
  font-weight: 900;
}

.priceRows strong {
  color: var(--white);
}

.priceNote {
  margin-top: 18px;
  color: #65736a;
  font-size: 9px;
  font-weight: 900;
  letter-spacing: 0.08em;
}

.howSection {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1px;
  margin-top: 26px;
  border: 1px solid var(--line);
  background: var(--line);
  box-shadow: 8px 8px 0 rgba(0,0,0,0.38);
}

.howSection > div {
  padding: 28px;
  background: #07100b;
}

.howSection span {
  color: var(--green);
  font-size: 11px;
  font-weight: 900;
}

.howSection strong {
  display: block;
  margin-top: 18px;
  font-size: 18px;
}

.howSection p {
  margin: 9px 0 0;
  color: var(--muted);
  line-height: 1.6;
}

.footer {
  display: flex;
  justify-content: space-between;
  gap: 28px;
  margin-top: 26px;
  padding: 26px;
  border-top: 1px solid var(--line);
  color: #65736a;
}

.footer > div {
  display: grid;
  gap: 7px;
}

.footer strong {
  color: var(--green);
  font-size: 10px;
  letter-spacing: 0.1em;
}

.footer span {
  font-size: 10px;
}

.footer nav {
  display: flex;
  flex-wrap: wrap;
  gap: 18px;
}

.footer a {
  color: #7b8a81;
  text-decoration: none;
  font-size: 10px;
  font-weight: 900;
}

@media (max-width: 1050px) {
  .hero,
  .paidSection {
    grid-template-columns: 1fr;
  }

  .pixelStadium {
    min-height: 500px;
  }

  .statsGrid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 760px) {
  .shell {
    width: min(100% - 20px, 1480px);
    padding-top: 10px;
  }

  .header {
    min-height: auto;
    padding: 15px;
    align-items: flex-start;
  }

  .brand {
    font-size: 10px;
  }

  .nav {
    display: grid;
    grid-template-columns: repeat(2, auto);
  }

  .nav a {
    padding: 8px 9px;
    font-size: 8px;
  }

  .hero {
    min-height: auto;
    margin-top: 12px;
  }

  .heroCopy {
    padding: 34px 24px;
  }

  .hero h1 {
    font-size: clamp(56px, 19vw, 92px);
  }

  .pixelStadium {
    min-height: 380px;
  }

  .stand {
    top: 130px;
  }

  .pitch {
    height: 160px;
  }

  .section {
    margin-top: 14px;
    padding: 18px;
  }

  .sectionHeading {
    align-items: flex-start;
  }

  .pickGrid,
  .statsGrid,
  .howSection {
    grid-template-columns: 1fr;
  }

  .pickMetrics {
    grid-template-columns: repeat(3, 1fr);
  }

  .pickMetrics div {
    padding: 13px 12px;
  }

  .pickMetrics strong {
    font-size: 18px;
  }

  .paidSection {
    margin-top: 14px;
  }

  .footer {
    flex-direction: column;
  }
}

@media (max-width: 480px) {
  .header {
    display: block;
  }

  .nav {
    margin-top: 14px;
    grid-template-columns: repeat(4, 1fr);
  }

  .nav a {
    text-align: center;
  }

  .heroActions {
    display: grid;
  }

  .heroActions a {
    width: 100%;
    box-sizing: border-box;
  }

  .heroMeta {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
  }

  .selection {
    align-items: flex-start;
    flex-direction: column;
  }

  .liveRecord {
    align-items: flex-start;
    flex-wrap: wrap;
  }

  .liveRecord > span:last-child {
    width: 100%;
    margin-left: 18px;
  }
}

/* MOBILE LAUNCH V1 */
.mobileBottomNav {
  display: none;
}

.mobileBottomItem {
  text-decoration: none;
}

@media (max-width: 760px) {
  .page {
    padding-bottom: 78px;
  }

  .shell {
    width: calc(100% - 16px);
    padding-top: 8px;
    padding-bottom: 18px;
  }

  .header {
    min-height: 56px;
    padding: 10px 12px;
    box-shadow: 4px 4px 0 rgba(0,0,0,0.35);
  }

  .brand {
    gap: 8px;
    font-size: 9px;
    letter-spacing: 0.1em;
  }

  .brandMark {
    width: 30px;
    height: 30px;
    font-size: 9px;
    box-shadow: 2px 2px 0 #020402;
  }

  .header .nav {
    display: none;
  }

  .hero {
    grid-template-columns: 1fr;
    gap: 10px;
    margin-top: 10px;
    min-height: auto;
  }

  .heroCopy {
    padding: 30px 22px 26px;
    box-shadow: 5px 5px 0 rgba(0,0,0,0.4);
  }

  .eyebrow {
    font-size: 9px;
    line-height: 1.5;
  }

  .hero h1 {
    margin: 20px 0 18px;
    font-size: clamp(58px, 20vw, 88px);
    line-height: 0.82;
  }

  .heroCopy > p {
    font-size: 15px;
    line-height: 1.55;
  }

  .heroActions {
    display: grid;
    grid-template-columns: 1fr;
    gap: 9px;
    margin-top: 24px;
  }

  .primaryButton,
  .secondaryButton {
    width: 100%;
    min-height: 50px;
    box-sizing: border-box;
  }

  .heroMeta {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 6px;
    margin-top: 22px;
  }

  .heroMeta span {
    padding: 8px 6px;
    text-align: center;
    font-size: 7px;
  }

  .pixelStadium {
    min-height: 300px;
    box-shadow: 5px 5px 0 rgba(0,0,0,0.4);
  }

  .scoreboard {
    top: 26px;
    width: 150px;
    padding: 11px 12px;
  }

  .scoreboard strong {
    font-size: 12px;
  }

  .floodlightLeft,
  .floodlightRight {
    top: 8px;
    height: 145px;
    width: 12px;
  }

  .floodlightLeft {
    left: 24px;
  }

  .floodlightRight {
    right: 24px;
  }

  .floodlightLeft::before,
  .floodlightRight::before {
    width: 52px;
    height: 28px;
  }

  .floodlightLeft::before {
    left: -20px;
  }

  .floodlightRight::before {
    right: -20px;
  }

  .stand {
    top: 104px;
    height: 108px;
  }

  .crowd,
  .crowdSecond {
    inset-left: 10px;
    inset-right: 10px;
    height: 34px;
  }

  .crowdSecond {
    top: 58px;
  }

  .pitch {
    left: 8%;
    right: 8%;
    bottom: 14px;
    height: 120px;
  }

  .centerCircle {
    width: 52px;
    height: 52px;
  }

  .goalLeft,
  .goalRight {
    width: 34px;
    height: 65px;
  }

  .section {
    margin-top: 10px;
    padding: 16px;
    box-shadow: 4px 4px 0 rgba(0,0,0,0.34);
  }

  .sectionHeading {
    display: grid;
    grid-template-columns: 1fr;
    gap: 10px;
    margin-bottom: 16px;
  }

  .sectionHeading h2,
  .paidCopy h2 {
    font-size: 34px;
  }

  .sectionDate,
  .textLink {
    font-size: 9px;
  }

  .pickGrid,
  .statsGrid,
  .howSection,
  .paidSection {
    grid-template-columns: 1fr;
  }

  .pickGrid {
    gap: 10px;
  }

  .pickTop,
  .competition,
  .teams {
    padding-left: 16px;
    padding-right: 16px;
  }

  .teams {
    padding-top: 20px;
    padding-bottom: 20px;
  }

  .teams strong {
    font-size: 28px;
  }

  .selection {
    margin: 0 16px 16px;
    padding: 16px !important;
  }

  .selection strong {
    font-size: 22px;
  }

  .pickMetrics div {
    padding: 12px 10px 14px;
  }

  .pickMetrics span {
    font-size: 7px;
  }

  .pickMetrics strong {
    font-size: 17px;
  }

  .sectionFooter {
    align-items: flex-start;
    flex-direction: column;
    gap: 8px;
  }

  .statsGrid {
    gap: 8px;
  }

  .statCard {
    min-height: auto;
    padding: 18px;
  }

  .statCard strong {
    margin-top: 10px;
    font-size: 34px;
  }

  .liveRecord {
    align-items: flex-start;
    flex-wrap: wrap;
  }

  .liveRecord > span:last-child {
    width: 100%;
    margin-left: 18px;
  }

  .paidSection {
    gap: 10px;
    margin-top: 10px;
  }

  .paidCopy,
  .pricePanel {
    box-shadow: 4px 4px 0 rgba(0,0,0,0.34);
  }

  .paidCopy,
  .pricePanel {
    padding: 20px;
  }

  .priceTop {
    padding: 18px;
  }

  .priceTop strong {
    font-size: 48px;
  }

  .howSection {
    margin-top: 10px;
  }

  .howSection > div {
    padding: 20px;
  }

  .footer {
    margin-top: 12px;
    padding: 20px 6px 8px;
    flex-direction: column;
  }

  .footer nav {
    display: none;
  }

  .mobileBottomNav {
    position: fixed;
    z-index: 100;
    left: 8px;
    right: 8px;
    bottom: 8px;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    min-height: 62px;
    border: 1px solid var(--line-strong);
    background: rgba(3, 8, 6, 0.97);
    box-shadow: 5px 5px 0 rgba(0,0,0,0.55);
    backdrop-filter: blur(8px);
  }

  .mobileBottomItem {
    display: grid;
    place-items: center;
    align-content: center;
    gap: 4px;
    min-width: 0;
    border-right: 1px solid var(--line);
    color: #829087;
    text-align: center;
    font-size: 7px;
    font-weight: 900;
    letter-spacing: 0.05em;
  }

  .mobileBottomItem:last-child {
    border-right: 0;
  }

  .mobileBottomItem span {
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    color: var(--green);
    font-size: 11px;
    font-weight: 900;
  }

  .mobileBottomItem:active {
    background: #0b2013;
    color: var(--green);
  }
}

@media (max-width: 390px) {
  .hero h1 {
    font-size: 54px;
  }

  .heroMeta {
    grid-template-columns: 1fr;
  }

  .mobileBottomItem {
    font-size: 6px;
  }
}
