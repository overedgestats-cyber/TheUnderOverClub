.page {
  display: grid;
  gap: 8px;
  color: #f2efe3;
}

.hero,
.gamePanel,
.card,
.leaderboard,
.disclaimer {
  border: 3px solid var(--retro-line);
  background: #06090c;
  box-shadow: inset 0 0 0 2px #020304, 4px 4px 0 #000;
}

.hero {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 390px;
  gap: 18px;
  align-items: center;
  padding: 20px;
}

.hero > div:first-child > span {
  color: #79ff1d;
  font-size: 8px;
  font-weight: 900;
}

.hero h1 {
  margin: 8px 0;
  color: #f2efe3 !important;
  font-size: clamp(24px, 4vw, 48px);
  line-height: 1.04;
}

.hero h1 b {
  color: #ffd329 !important;
}

.hero p {
  margin: 0;
  color: #aeb8bf !important;
  font-size: 8px;
  line-height: 1.65;
}

.heroHud {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  border: 2px solid #445047;
  background: #080d0a;
}

.heroHud div {
  min-height: 78px;
  display: grid;
  place-content: center;
  text-align: center;
}

.heroHud div + div {
  border-left: 1px solid #344039;
}

.heroHud span {
  color: #9aa59d;
  font-size: 6px;
  font-weight: 900;
}

.heroHud strong {
  margin-top: 6px;
  color: #79ff1d;
  font-size: 17px;
}

.mainGrid {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 260px;
  gap: 8px;
}

.panelTitle {
  min-height: 50px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8px 12px;
  border-bottom: 2px solid var(--retro-line-soft);
}

.panelTitle > div {
  display: flex;
  align-items: center;
  gap: 8px;
}

.panelTitle span,
.panelTitle h2 {
  color: #ffd329 !important;
}

.panelTitle h2 {
  margin: 0;
  font-size: 13px;
}

.panelTitle > strong {
  color: #9ca6ad;
  font-size: 7px;
}

.scene {
  position: relative;
  height: 600px;
  overflow: hidden;
  background: #101820;
}

.skyGlow {
  position: absolute;
  inset: 0 0 auto;
  height: 160px;
  background:
    linear-gradient(180deg, rgba(130, 190, 220, 0.18), rgba(20, 30, 40, 0));
  pointer-events: none;
}

.crowd {
  position: absolute;
  z-index: 1;
  inset: 0 0 auto;
  height: 170px;
  background:
    repeating-linear-gradient(
      90deg,
      #1e2831 0 5px,
      #3c4b56 5px 8px,
      #12191f 8px 13px
    ),
    linear-gradient(180deg, #34414b, #171e24);
  border-bottom: 6px solid #e8e5d9;
}

.crowdPixels {
  height: 108px;
  overflow: hidden;
  padding-top: 25px;
  color: #d17a50;
  font-size: 16px;
  letter-spacing: 0.7em;
  text-align: center;
  white-space: nowrap;
  text-shadow:
    0 8px 0 #6386a0,
    0 16px 0 #d3c779,
    0 24px 0 #67566f;
}

.adverts {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 7px;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 4px;
  padding: 0 16px;
}

.adverts span {
  display: grid;
  place-items: center;
  min-height: 33px;
  border: 2px solid #151b20;
  background: #e7ece8;
  color: #173b49;
  font-size: 7px;
  font-weight: 900;
}

.adverts span:nth-child(2) {
  background: #f06b8c;
  color: #fff;
}

.adverts span:nth-child(3) {
  background: #f0c62e;
  color: #8a3419;
}

.pitch {
  position: absolute;
  z-index: 2;
  inset: 164px 0 0;
  overflow: hidden;
  background:
    repeating-linear-gradient(
      90deg,
      #328838 0 86px,
      #2c7c32 86px 172px
    );
}

.pitch::before {
  content: "";
  position: absolute;
  left: -8%;
  right: -8%;
  top: 56%;
  height: 5px;
  background: rgba(255,255,255,0.7);
  transform: perspective(300px) rotateX(68deg);
  transform-origin: center;
}

.goal {
  position: absolute;
  z-index: 5;
  left: 50%;
  top: 22px;
  width: min(72%, 760px);
  height: 245px;
  border: 10px solid #f8f8ef;
  border-bottom-width: 12px;
  transform: translateX(-50%);
  background: rgba(12, 45, 24, 0.16);
  box-shadow:
    0 12px 0 rgba(0,0,0,0.25),
    inset 0 0 0 3px #7d827b;
}

.goal::before,
.goal::after {
  content: "";
  position: absolute;
  bottom: -26px;
  width: 10px;
  height: 27px;
  background: #f8f8ef;
}

.goal::before {
  left: -10px;
  transform: skewX(-23deg);
}

.goal::after {
  right: -10px;
  transform: skewX(23deg);
}

.net {
  position: absolute;
  inset: 0;
  z-index: 1;
  pointer-events: none;
  background:
    repeating-linear-gradient(
      0deg,
      transparent 0 20px,
      rgba(240, 245, 241, 0.55) 20px 22px
    ),
    repeating-linear-gradient(
      90deg,
      transparent 0 30px,
      rgba(240, 245, 241, 0.55) 30px 32px
    );
}

.zone {
  position: absolute;
  z-index: 20;
  width: 31%;
  height: 38%;
  border: 2px dashed rgba(121, 255, 29, 0.48);
  background: rgba(121, 255, 29, 0.03);
  color: transparent;
  cursor: pointer;
  pointer-events: auto;
  touch-action: manipulation;
}

.zone:hover:not(:disabled),
.zone:focus-visible:not(:disabled) {
  border-style: solid;
  border-color: #79ff1d;
  background: rgba(121, 255, 29, 0.14);
  color: #79ff1d;
  outline: none;
}

.zone span {
  font: inherit;
  font-size: 7px;
  font-weight: 900;
}

.zone_top_left {
  top: 3%;
  left: 3%;
}

.zone_top_right {
  top: 3%;
  right: 3%;
}

.zone_center {
  top: 31%;
  left: 34.5%;
}

.zone_bottom_left {
  left: 3%;
  bottom: 3%;
}

.zone_bottom_right {
  right: 3%;
  bottom: 3%;
}

.keeperWrap {
  position: absolute;
  z-index: 10;
  width: 90px;
  height: 112px;
  pointer-events: none;
  transition:
    left 0.45s steps(5, end),
    top 0.45s steps(5, end),
    bottom 0.45s steps(5, end),
    transform 0.45s steps(5, end);
}

.keeper_center {
  left: 50%;
  bottom: 0;
  transform: translateX(-50%);
}

.keeper_top_left {
  left: 18%;
  top: 17%;
  bottom: auto;
  transform: translate(-50%, -50%) rotate(-24deg);
}

.keeper_top_right {
  left: 82%;
  top: 17%;
  bottom: auto;
  transform: translate(-50%, -50%) rotate(24deg);
}

.keeper_bottom_left {
  left: 19%;
  bottom: 0;
  transform: translateX(-50%) rotate(-34deg);
}

.keeper_bottom_right {
  left: 81%;
  bottom: 0;
  transform: translateX(-50%) rotate(34deg);
}

.keeper {
  position: relative;
  width: 100%;
  height: 100%;
}

.keeperHead {
  position: absolute;
  left: 35px;
  top: 4px;
  width: 20px;
  height: 20px;
  background: #d49b68;
  box-shadow: 3px 3px 0 #4c2d19;
}

.keeperTorso {
  position: absolute;
  left: 27px;
  top: 28px;
  width: 38px;
  height: 45px;
  background: #777c82;
  box-shadow: 4px 4px 0 #25292d;
}

.keeperArmLeft,
.keeperArmRight {
  position: absolute;
  top: 38px;
  width: 34px;
  height: 10px;
  background: #777c82;
}

.keeperArmLeft {
  left: 1px;
  transform: rotate(-18deg);
}

.keeperArmRight {
  right: 1px;
  transform: rotate(18deg);
}

.keeperLegLeft,
.keeperLegRight {
  position: absolute;
  top: 72px;
  width: 12px;
  height: 28px;
  background: #d9dde1;
}

.keeperLegLeft {
  left: 29px;
}

.keeperLegRight {
  right: 29px;
}

.keeperBootLeft,
.keeperBootRight {
  position: absolute;
  top: 99px;
  width: 18px;
  height: 7px;
  background: #101418;
}

.keeperBootLeft {
  left: 24px;
}

.keeperBootRight {
  right: 24px;
}

.cameraLane {
  position: absolute;
  left: 50%;
  top: 270px;
  width: 330px;
  height: 340px;
  border-left: 4px solid rgba(255,255,255,0.42);
  border-right: 4px solid rgba(255,255,255,0.42);
  transform: translateX(-50%) perspective(360px) rotateX(70deg);
  transform-origin: top;
  pointer-events: none;
}

.penaltyMark {
  position: absolute;
  left: 50%;
  top: 390px;
  width: 11px;
  height: 11px;
  background: #f7f7ec;
  transform: translateX(-50%);
}

.ball {
  position: absolute;
  z-index: 30;
  width: 118px;
  height: 118px;
  border: 6px solid #1a1a1a;
  border-radius: 50%;
  background: #efefe7;
  box-shadow:
    8px 10px 0 rgba(0,0,0,0.28),
    inset -7px -7px 0 #b9b9b0;
  pointer-events: none;
  transition:
    left 0.5s steps(6, end),
    top 0.5s steps(6, end),
    width 0.5s steps(6, end),
    height 0.5s steps(6, end),
    transform 0.5s steps(6, end);
}

.ballPatchA,
.ballPatchB,
.ballPatchC,
.ballPatchD,
.ballPatchE {
  position: absolute;
  width: 24px;
  height: 22px;
  background: #171717;
  clip-path: polygon(50% 0%, 100% 35%, 82% 100%, 18% 100%, 0 35%);
}

.ballPatchA {
  left: 42px;
  top: 37px;
}

.ballPatchB {
  left: 11px;
  top: 24px;
  transform: rotate(-18deg);
}

.ballPatchC {
  right: 11px;
  top: 24px;
  transform: rotate(18deg);
}

.ballPatchD {
  left: 19px;
  bottom: 13px;
  transform: rotate(18deg);
}

.ballPatchE {
  right: 19px;
  bottom: 13px;
  transform: rotate(-18deg);
}

.ballStart {
  left: 50%;
  top: 385px;
  transform: translateX(-50%);
}

.ball_top_left,
.ball_top_right,
.ball_center,
.ball_bottom_left,
.ball_bottom_right {
  width: 34px;
  height: 34px;
  border-width: 2px;
}

.ball_top_left .ballPatchA,
.ball_top_right .ballPatchA,
.ball_center .ballPatchA,
.ball_bottom_left .ballPatchA,
.ball_bottom_right .ballPatchA {
  left: 10px;
  top: 9px;
  width: 10px;
  height: 9px;
}

.ball_top_left .ballPatchB,
.ball_top_left .ballPatchC,
.ball_top_left .ballPatchD,
.ball_top_left .ballPatchE,
.ball_top_right .ballPatchB,
.ball_top_right .ballPatchC,
.ball_top_right .ballPatchD,
.ball_top_right .ballPatchE,
.ball_center .ballPatchB,
.ball_center .ballPatchC,
.ball_center .ballPatchD,
.ball_center .ballPatchE,
.ball_bottom_left .ballPatchB,
.ball_bottom_left .ballPatchC,
.ball_bottom_left .ballPatchD,
.ball_bottom_left .ballPatchE,
.ball_bottom_right .ballPatchB,
.ball_bottom_right .ballPatchC,
.ball_bottom_right .ballPatchD,
.ball_bottom_right .ballPatchE {
  display: none;
}

.ball_top_left {
  left: 27%;
  top: 80px;
  transform: translate(-50%, -50%);
}

.ball_top_right {
  left: 73%;
  top: 80px;
  transform: translate(-50%, -50%);
}

.ball_center {
  left: 50%;
  top: 145px;
  transform: translate(-50%, -50%);
}

.ball_bottom_left {
  left: 28%;
  top: 205px;
  transform: translate(-50%, -50%);
}

.ball_bottom_right {
  left: 72%;
  top: 205px;
  transform: translate(-50%, -50%);
}

.ballActive {
  animation: ballPulse 0.55s steps(2, end);
}

@keyframes ballPulse {
  0%, 100% { filter: brightness(1); }
  50% { filter: brightness(1.35); }
}

.swipeText {
  position: absolute;
  z-index: 25;
  left: 50%;
  bottom: 18px;
  transform: translateX(-50%);
  padding: 9px 14px;
  border: 3px solid #1f2830;
  background: rgba(8, 12, 15, 0.88);
  color: #fff;
  font-size: 11px;
  font-weight: 900;
  text-shadow: 2px 2px 0 #000;
  white-space: nowrap;
}

.resultBanner {
  display: flex;
  align-items: center;
  gap: 18px;
  margin: 8px 10px 10px;
  padding: 12px 14px;
  border: 2px solid currentColor;
  background: #090d10;
}

.resultBanner strong {
  font-size: 18px;
}

.resultBanner span {
  font-size: 11px;
  font-weight: 900;
}

.resultBanner small {
  margin-left: auto;
  color: #aab4bb;
  font-size: 6px;
  font-weight: 900;
}

.resultGoal {
  color: #79ff1d;
}

.resultSave {
  color: #ff4d4d;
}

.error {
  display: grid;
  gap: 5px;
  margin: 8px 10px 10px;
  padding: 12px;
  border: 3px solid #ff4d4d;
  background: #240909;
  color: #ff8b8b;
  font-size: 8px;
  font-weight: 900;
}

.attemptStrip {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 5px;
  padding: 10px;
  border-top: 2px solid var(--retro-line-soft);
}

.attemptStrip > div {
  min-height: 54px;
  display: grid;
  place-content: center;
  gap: 5px;
  border: 2px solid #30363c;
  text-align: center;
}

.attemptStrip span {
  color: #8f9aa2;
  font-size: 6px;
  font-weight: 900;
}

.attemptStrip strong {
  font-size: 8px;
}

.attemptGoal {
  border-color: #4e9e19 !important;
  color: #79ff1d;
  background: #0b1e08;
}

.attemptSave {
  border-color: #d73535 !important;
  color: #ff5757;
  background: #1b0909;
}

.attemptPending {
  color: #7e8790;
}

.sideRail {
  display: grid;
  align-content: start;
  gap: 8px;
}

.card {
  padding: 14px;
  color: #f2efe3;
}

.card > span {
  color: #ffd329;
  font-size: 9px;
  font-weight: 900;
}

.stats {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  margin-top: 11px;
  border: 1px solid var(--retro-line-soft);
}

.stats div {
  min-height: 76px;
  display: grid;
  place-content: center;
  text-align: center;
}

.stats div:nth-child(even) {
  border-left: 1px solid var(--retro-line-soft);
}

.stats div:nth-child(n + 3) {
  border-top: 1px solid var(--retro-line-soft);
}

.stats small {
  color: #aeb8bf;
  font-size: 6px;
  font-weight: 900;
}

.stats strong {
  margin-top: 6px;
  color: #79ff1d;
  font-size: 18px;
}

.rules {
  margin-top: 10px;
}

.rules p {
  display: flex;
  justify-content: space-between;
  gap: 8px;
  margin: 0;
  padding: 9px 0;
  border-bottom: 1px solid var(--retro-line-soft);
}

.rules b {
  color: #b8c0c5;
  font-size: 7px;
}

.rules strong {
  color: #79ff1d;
  font-size: 9px;
}

.prizes {
  display: grid;
  gap: 6px;
  margin-top: 11px;
}

.prizes div {
  display: grid;
  grid-template-columns: 42px 1fr;
  align-items: center;
  gap: 8px;
  padding: 9px;
  border: 1px solid #4e4420;
  background: #141007;
}

.prizes strong {
  color: #ffd329;
  font-size: 8px;
}

.prizes span {
  color: #d8ca94;
  font-size: 7px;
  font-weight: 900;
}

.leaderboard {
  overflow: hidden;
}

.table {
  padding: 8px;
}

.tableHead,
.table > div:not(.tableHead):not(.noPlayers) {
  display: grid;
  grid-template-columns: 60px minmax(160px, 1fr) 110px 100px 100px;
  align-items: center;
  min-height: 42px;
}

.tableHead {
  color: #9ca7af;
  font-size: 6px;
  font-weight: 900;
}

.table > div:not(.tableHead):not(.noPlayers) {
  border-top: 1px solid var(--retro-line-soft);
  color: #d2d7da;
  font-size: 8px;
}

.table > div > strong {
  color: #ffd329;
}

.table > div > b {
  color: #79ff1d;
}

.currentPlayer {
  background: #0c1b09;
  box-shadow: inset 3px 0 0 #79ff1d;
}

.noPlayers {
  min-height: 100px;
  display: grid;
  place-items: center;
  color: #a2abb2;
  font-size: 8px;
  font-weight: 900;
}

.disclaimer {
  padding: 12px 14px;
  color: #9aa4ac;
  font-size: 7px;
  font-weight: 900;
  line-height: 1.6;
}

.loading {
  min-height: 460px;
  display: grid;
  place-content: center;
  gap: 12px;
  border: 3px solid var(--retro-line);
  background: #06090c;
  color: #ffd329;
  text-align: center;
  font-size: 10px;
  font-weight: 900;
}

.loading span {
  max-width: 620px;
  color: #a8b0b7;
  font-size: 8px;
}

.loading button {
  justify-self: center;
  padding: 9px 13px;
  border: 2px solid #4e9e19;
  background: #10210d;
  color: #79ff1d;
  font: inherit;
  font-size: 8px;
  cursor: pointer;
}

@media (max-width: 1100px) {
  .hero {
    grid-template-columns: 1fr;
  }

  .mainGrid {
    grid-template-columns: 1fr;
  }

  .sideRail {
    grid-template-columns: repeat(3, 1fr);
  }
}

@media (max-width: 760px) {
  .hero {
    padding: 14px;
  }

  .heroHud {
    grid-template-columns: 1fr;
  }

  .heroHud div + div {
    border-left: 0;
    border-top: 1px solid #344039;
  }

  .scene {
    height: 520px;
  }

  .goal {
    width: 86%;
    height: 210px;
  }

  .ball {
    width: 88px;
    height: 88px;
  }

  .ballStart {
    top: 345px;
  }

  .sideRail {
    grid-template-columns: 1fr;
  }

  .resultBanner {
    align-items: flex-start;
    flex-direction: column;
  }

  .resultBanner small {
    margin-left: 0;
  }

  .attemptStrip {
    grid-template-columns: repeat(4, 1fr);
  }

  .table {
    overflow-x: auto;
  }

  .tableHead,
  .table > div:not(.tableHead):not(.noPlayers) {
    min-width: 640px;
  }
}
