.page {
  width: 100%;
  min-width: 0;
  display: grid;
  gap: 10px;
  overflow: hidden;
  color: #f5f2e8;
  background: #030609;
}

.page *,
.page *::before,
.page *::after {
  box-sizing: border-box;
}

.gameLayout {
  min-width: 0;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 278px;
  gap: 10px;
  align-items: start;
}

.mainColumn {
  min-width: 0;
  display: grid;
  gap: 10px;
}

.gamePanel,
.card,
.leaderboard,
.disclaimer {
  min-width: 0;
  border: 2px solid #32383d;
  background: #05080a;
  box-shadow: 3px 3px 0 #000;
}

.topBar,
.sectionTitle {
  min-height: 48px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 8px 13px;
  border-bottom: 2px solid #2a3035;
  background: #050709;
}

.topBar > div {
  display: flex;
  align-items: center;
  gap: 9px;
}

.topBar strong,
.sectionTitle strong {
  color: #ffd329;
  font-size: 10px;
  letter-spacing: 0.04em;
}

.topBar > span,
.sectionTitle > span {
  color: #f3f3ed;
  font-size: 8px;
  font-weight: 900;
}

.scene {
  position: relative;
  width: 100%;
  aspect-ratio: 1275 / 660;
  overflow: hidden;
  isolation: isolate;
  background:
    url("/game/penalty-scene-exact.png")
    center / 100% 100%
    no-repeat;
  image-rendering: pixelated;
}

.goalInteractive {
  position: absolute;
  z-index: 15;
  left: 23.45%;
  top: 23.5%;
  width: 58.5%;
  height: 41%;
  pointer-events: none;
}

.target {
  position: absolute;
  z-index: 30;
  width: 20%;
  height: 34%;
  border: 0;
  background: transparent;
  cursor: pointer;
  pointer-events: auto;
}

.target:hover:not(:disabled),
.target:focus-visible:not(:disabled) {
  outline: 3px solid rgba(255, 211, 41, 0.75);
  outline-offset: -4px;
  background: rgba(255, 211, 41, 0.08);
}

.target:disabled {
  cursor: not-allowed;
}


.target_top_left {
  left: 6%;
  top: 8%;
}

.target_top_right {
  right: 6%;
  top: 8%;
}

.target_center {
  left: 40%;
  top: 9%;
  height: 36%;
}

.target_bottom_left {
  left: 7%;
  bottom: 7%;
}

.target_bottom_right {
  right: 7%;
  bottom: 7%;
}

.keeperWrap {
  position: absolute;
  z-index: 25;
  width: 82px;
  height: 112px;
  pointer-events: none;
  transition:
    left 0.46s steps(5, end),
    top 0.46s steps(5, end),
    bottom 0.46s steps(5, end),
    transform 0.46s steps(5, end);
}

.keeper_center {
  left: 50%;
  bottom: -16px;
  transform: translateX(-50%);
}

.keeper_top_left {
  left: 23%;
  top: 27%;
  bottom: auto;
  transform: translate(-50%, -50%) rotate(-26deg);
}

.keeper_top_right {
  left: 77%;
  top: 27%;
  bottom: auto;
  transform: translate(-50%, -50%) rotate(26deg);
}

.keeper_bottom_left {
  left: 23%;
  bottom: -16px;
  transform: translateX(-50%) rotate(-34deg);
}

.keeper_bottom_right {
  left: 77%;
  bottom: -16px;
  transform: translateX(-50%) rotate(34deg);
}

.keeper {
  position: relative;
  width: 100%;
  height: 100%;
}

.keeperHair {
  position: absolute;
  left: 29px;
  top: 1px;
  width: 24px;
  height: 8px;
  background: #2b1c12;
}

.keeperHead {
  position: absolute;
  left: 31px;
  top: 7px;
  width: 20px;
  height: 20px;
  background: #d49b68;
  box-shadow: 3px 3px 0 #4c2d19;
}

.keeperBody {
  position: absolute;
  left: 23px;
  top: 31px;
  width: 38px;
  height: 42px;
  background: #6f7478;
  box-shadow: 4px 4px 0 #25292d;
}

.keeperArmLeft,
.keeperArmRight {
  position: absolute;
  top: 39px;
  width: 31px;
  height: 9px;
  background: #6f7478;
}

.keeperArmLeft {
  left: 0;
  transform: rotate(-18deg);
}

.keeperArmRight {
  right: 0;
  transform: rotate(18deg);
}

.keeperShorts {
  position: absolute;
  left: 25px;
  top: 72px;
  width: 34px;
  height: 13px;
  background: #202428;
}

.keeperLegLeft,
.keeperLegRight {
  position: absolute;
  top: 84px;
  width: 10px;
  height: 17px;
  background: #dedfda;
}

.keeperLegLeft {
  left: 26px;
}

.keeperLegRight {
  right: 26px;
}

.keeperBootLeft,
.keeperBootRight {
  position: absolute;
  top: 100px;
  width: 17px;
  height: 7px;
  background: #101418;
}

.keeperBootLeft {
  left: 20px;
}

.keeperBootRight {
  right: 20px;
}

.ball {
  position: absolute;
  z-index: 40;
  width: clamp(82px, 7vw, 112px);
  aspect-ratio: 1;
  border: 5px solid #171717;
  border-radius: 50%;
  background: #efefe8;
  box-shadow:
    7px 9px 0 rgba(0, 0, 0, 0.26),
    inset -7px -7px 0 #b9b9b0;
  pointer-events: none;
  transition:
    left 0.52s steps(6, end),
    top 0.52s steps(6, end),
    width 0.52s steps(6, end),
    transform 0.52s steps(6, end);
}

.ballPatchCenter,
.ballPatchOne,
.ballPatchTwo,
.ballPatchThree,
.ballPatchFour {
  position: absolute;
  width: 21%;
  height: 20%;
  background: #171717;
  clip-path:
    polygon(
      50% 0,
      100% 35%,
      82% 100%,
      18% 100%,
      0 35%
    );
}

.ballPatchCenter {
  left: 39%;
  top: 31%;
}

.ballPatchOne {
  left: 8%;
  top: 22%;
}

.ballPatchTwo {
  right: 8%;
  top: 22%;
}

.ballPatchThree {
  left: 16%;
  bottom: 11%;
}

.ballPatchFour {
  right: 16%;
  bottom: 11%;
}

.ballStart {
  left: 53.3%;
  top: 70.5%;
  transform: translateX(-50%);
}

.ball_top_left,
.ball_top_right,
.ball_center,
.ball_bottom_left,
.ball_bottom_right {
  width: 30px;
  transform: translate(-50%, -50%);
}

.ball_top_left span:not(.ballPatchCenter),
.ball_top_right span:not(.ballPatchCenter),
.ball_center span:not(.ballPatchCenter),
.ball_bottom_left span:not(.ballPatchCenter),
.ball_bottom_right span:not(.ballPatchCenter) {
  display: none;
}

.ball_top_left .ballPatchCenter,
.ball_top_right .ballPatchCenter,
.ball_center .ballPatchCenter,
.ball_bottom_left .ballPatchCenter,
.ball_bottom_right .ballPatchCenter {
  left: 33%;
  top: 29%;
  width: 28%;
  height: 28%;
}

.ball_top_left {
  left: 35%;
  top: 32%;
}

.ball_top_right {
  left: 72%;
  top: 32%;
}

.ball_center {
  left: 53.3%;
  top: 39%;
}

.ball_bottom_left {
  left: 35%;
  top: 54%;
}

.ball_bottom_right {
  left: 72%;
  top: 54%;
}

.actionPrompt {
  position: absolute;
  z-index: 50;
  left: 53.3%;
  bottom: 1.5%;
  transform: translateX(-50%);
  min-width: 300px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 8px 13px;
  border: 3px solid #11171b;
  background: #05080a;
  color: #fff;
  font-size: clamp(7px, 0.8vw, 10px);
  font-weight: 900;
  white-space: nowrap;
}

.actionPrompt > span {
  color: #ffd329;
  font-size: 20px;
}

.resultBar {
  min-height: 48px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 8px 13px;
  border-top: 2px solid #31373d;
  border-bottom: 2px solid #31373d;
  background: #05080a;
}

.resultBar > div {
  display: flex;
  align-items: center;
  gap: 10px;
}

.resultBar strong {
  color: #b8c1c6;
  font-size: 17px;
}

.resultBar b {
  color: #f0f0ea;
  font-size: 9px;
}

.resultGoal strong,
.resultGoal b {
  color: #79ff1d;
}

.resultSave strong,
.resultSave b {
  color: #ff4d4d;
}

.clock {
  color: #cbd1d5;
  font-size: 7px;
  font-weight: 900;
}

.error {
  display: grid;
  gap: 4px;
  margin: 8px;
  padding: 12px;
  border: 3px solid #ff4e4e;
  background: #270909;
  color: #ff8a8a;
  font-size: 7px;
  font-weight: 900;
}

.attempts {
  display: grid;
  grid-template-columns: repeat(7, minmax(0, 1fr));
  gap: 5px;
  padding: 7px;
}

.attempts > div {
  min-height: 70px;
  display: grid;
  place-content: center;
  gap: 5px;
  border: 2px solid #303941;
  text-align: center;
}

.attempts span {
  color: #929aa0;
  font-size: 6px;
  font-weight: 900;
}

.attempts strong {
  font-size: 9px;
}

.attemptGoal {
  border-color: #4e9f19 !important;
  background: #0d2109;
  color: #79ff1d;
}

.attemptSave {
  border-color: #c53737 !important;
  background: #1d0909;
  color: #ff5555;
}

.attemptPending {
  color: #747d84;
}

.sideRail {
  min-width: 0;
  display: grid;
  align-content: start;
  gap: 10px;
}

.card {
  padding: 14px;
}

.card > span {
  color: #ffd329;
  font-size: 10px;
  font-weight: 900;
}

.statGrid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  margin-top: 12px;
  border: 1px solid #2a333a;
}

.statGrid div {
  min-height: 92px;
  display: grid;
  place-content: center;
  text-align: center;
}

.statGrid div:nth-child(even) {
  border-left: 1px solid #2a333a;
}

.statGrid div:nth-child(n + 3) {
  border-top: 1px solid #2a333a;
}

.statGrid small {
  color: #f0f0ea;
  font-size: 7px;
  font-weight: 900;
}

.statGrid strong {
  margin-top: 7px;
  color: #79ff1d;
  font-size: 22px;
}

.rankCell {
  grid-column: 1 / -1;
}

.rules {
  margin-top: 10px;
}

.rules p {
  display: flex;
  justify-content: space-between;
  gap: 8px;
  margin: 0;
  padding: 12px 0;
  border-bottom: 1px solid #2a333a;
}

.rules b {
  color: #f1f1eb;
  font-size: 8px;
}

.rules strong {
  color: #79ff1d;
  font-size: 9px;
}

.rules p:nth-child(2) strong {
  color: #ff4d4d;
}

.prizes {
  display: grid;
  gap: 7px;
  margin-top: 12px;
}

.prizes div {
  display: grid;
  grid-template-columns: 45px minmax(0, 1fr);
  gap: 8px;
  align-items: center;
  padding: 11px;
  border: 1px solid #5b4d20;
  background: #151007;
}

.prizes strong {
  color: #ffd329;
  font-size: 8px;
}

.prizes span {
  color: #f0e6bd;
  font-size: 7px;
  font-weight: 900;
}

.leaderboard {
  overflow: hidden;
}

.table {
  padding: 8px;
}

.tableHead,
.table > div:not(.tableHead) {
  display: grid;
  grid-template-columns:
    42px minmax(130px, 1fr)
    80px 70px 70px 70px;
  align-items: center;
  min-height: 42px;
}

.tableHead {
  color: #d1d5d8;
  font-size: 6px;
  font-weight: 900;
}

.table > div:not(.tableHead) {
  border-top: 1px solid #263037;
  color: #d6dade;
  font-size: 8px;
}

.table > div > strong {
  color: #ffd329;
}

.table > div > b {
  color: #79ff1d;
}

.currentPlayer {
  background: #0c1b09;
  box-shadow: inset 3px 0 0 #79ff1d;
}

.disclaimer {
  padding: 10px 12px;
  color: #8f999f;
  font-size: 6px;
  font-weight: 900;
}

.loading {
  min-height: 420px;
  display: grid;
  place-content: center;
  gap: 10px;
  border: 3px solid #313941;
  background: #06090c;
  color: #ffd329;
  text-align: center;
  font-size: 9px;
  font-weight: 900;
}

.loading span {
  max-width: 600px;
  color: #a3adb4;
  font-size: 7px;
}

.loading button {
  justify-self: center;
  padding: 8px 11px;
  border: 2px solid #4d991b;
  background: #10200d;
  color: #79ff1d;
  font: inherit;
  font-size: 7px;
}

@media (max-width: 1160px) {
  .gameLayout {
    grid-template-columns: 1fr;
  }

  .sideRail {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .rankCell {
    grid-column: auto;
  }
}

@media (max-width: 760px) {
  .topBar {
    min-height: 44px;
  }

  .ball {
    width: 72px;
  }

  .actionPrompt {
    min-width: 230px;
  }

  .sideRail {
    grid-template-columns: 1fr;
  }

  .rankCell {
    grid-column: 1 / -1;
  }

  .attempts {
    grid-template-columns: repeat(4, 1fr);
  }

  .resultBar {
    align-items: flex-start;
    flex-direction: column;
  }

  .table {
    overflow-x: auto;
  }

  .tableHead,
  .table > div:not(.tableHead) {
    min-width: 590px;
  }
}
