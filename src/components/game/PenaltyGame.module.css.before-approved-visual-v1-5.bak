.page {
  width: 100%;
  min-width: 0;
  display: grid;
  gap: 10px;
  overflow: hidden;
  background: #05080a;
  color: #f4f1e5;
}

.page *,
.page *::before,
.page *::after {
  box-sizing: border-box;
}

.gameHeader,
.gamePanel,
.card,
.leaderboard,
.disclaimer {
  border: 3px solid #313941;
  background: #070a0d;
  box-shadow: inset 0 0 0 2px #020304, 4px 4px 0 #000;
}

.gameHeader {
  min-width: 0;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 330px;
  align-items: center;
  gap: 20px;
  padding: 16px 18px;
}

.gameHeader > div:first-child > span {
  color: #79ff1d;
  font-size: 7px;
  font-weight: 900;
  letter-spacing: 0.12em;
}

.gameHeader h1 {
  margin: 6px 0 5px;
  color: #ffd329 !important;
  font-size: clamp(21px, 3vw, 36px);
  line-height: 1;
}

.gameHeader p {
  margin: 0;
  max-width: 700px;
  color: #a8b1b8 !important;
  font-size: 8px;
  line-height: 1.6;
}

.headerStats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  border: 2px solid #3b464e;
  background: #090d10;
}

.headerStats div {
  min-height: 68px;
  display: grid;
  place-content: center;
  text-align: center;
}

.headerStats div + div {
  border-left: 1px solid #313a41;
}

.headerStats small {
  color: #8d989f;
  font-size: 6px;
  font-weight: 900;
}

.headerStats strong {
  margin-top: 5px;
  color: #79ff1d;
  font-size: 16px;
}

.contentGrid {
  min-width: 0;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 238px;
  align-items: start;
  gap: 10px;
}

.gameColumn {
  min-width: 0;
  display: grid;
  gap: 10px;
}

.gamePanel {
  min-width: 0;
  overflow: hidden;
}

.panelBar,
.sectionTitle {
  min-height: 44px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 8px 12px;
  border-bottom: 2px solid #252d33;
}

.panelBar strong,
.sectionTitle strong {
  color: #ffd329;
  font-size: 8px;
}

.panelBar span,
.sectionTitle span {
  color: #9aa5ad;
  font-size: 7px;
  font-weight: 900;
}

.scene {
  position: relative;
  width: 100%;
  height: 510px;
  overflow: hidden;
  background: #111820;
}

.stadiumRoof {
  position: absolute;
  z-index: 1;
  inset: 0 0 auto;
  height: 45px;
  background:
    repeating-linear-gradient(90deg, #0c1115 0 24px, #1b242b 24px 28px);
  border-bottom: 3px solid #5e6870;
}

.crowd {
  position: absolute;
  z-index: 2;
  inset: 42px 0 auto;
  height: 128px;
  background:
    linear-gradient(180deg, #33414a 0 68%, #151c21 68%);
  border-bottom: 4px solid #dedfd7;
}

.crowdRows {
  height: 76px;
  display: grid;
  place-content: center;
  gap: 5px;
  overflow: hidden;
  color: #db7b50;
  font-size: 10px;
  letter-spacing: 0.5em;
  text-align: center;
  white-space: nowrap;
  text-shadow:
    0 7px 0 #7793a5,
    0 14px 0 #d6c96e,
    0 21px 0 #6d5b77;
}

.adBoards {
  position: absolute;
  left: 3%;
  right: 3%;
  bottom: 6px;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 5px;
}

.adBoards b {
  min-height: 29px;
  display: grid;
  place-items: center;
  border: 2px solid #11171b;
  color: #092a36;
  background: #e8eeee;
  font-size: 6px;
}

.adBoards b:nth-child(2) {
  background: #ef678d;
  color: white;
}

.adBoards b:nth-child(3) {
  background: #f3c92d;
  color: #7f3218;
}

.pitch {
  position: absolute;
  z-index: 3;
  inset: 166px 0 0;
  overflow: hidden;
  background:
    repeating-linear-gradient(
      90deg,
      #398f40 0 86px,
      #31823a 86px 172px
    );
}

/* Perspective pitch lines: the player's camera is behind the ball. */
.pitch::before,
.pitch::after {
  content: "";
  position: absolute;
  top: 93px;
  width: 4px;
  height: 420px;
  background: rgba(249, 249, 236, 0.7);
  transform-origin: top;
  pointer-events: none;
}

.pitch::before {
  left: 29%;
  transform: rotate(47deg);
}

.pitch::after {
  right: 29%;
  transform: rotate(-47deg);
}

.goalShadow {
  position: absolute;
  z-index: 1;
  left: 50%;
  top: 38px;
  width: 66%;
  height: 192px;
  background: rgba(0,0,0,0.18);
  transform: translateX(-50%) translateY(13px);
}

.goal {
  position: absolute;
  z-index: 5;
  left: 50%;
  top: 19px;
  width: min(70%, 700px);
  height: 220px;
  border: 9px solid #f6f5eb;
  border-bottom-width: 11px;
  transform: translateX(-50%);
  background: rgba(24, 76, 35, 0.22);
  box-shadow:
    7px 9px 0 rgba(0,0,0,0.3),
    inset 0 0 0 2px #8a8d86;
}

.net {
  position: absolute;
  inset: 0;
  z-index: 1;
  pointer-events: none;
  background:
    repeating-linear-gradient(
      0deg,
      transparent 0 18px,
      rgba(241, 246, 241, 0.52) 18px 20px
    ),
    repeating-linear-gradient(
      90deg,
      transparent 0 28px,
      rgba(241, 246, 241, 0.52) 28px 30px
    );
}

.target {
  position: absolute;
  z-index: 20;
  width: 31%;
  height: 38%;
  border: 2px dashed rgba(121,255,29,0.52);
  background: rgba(121,255,29,0.025);
  color: transparent;
  cursor: pointer;
  pointer-events: auto;
}

.target:hover:not(:disabled),
.target:focus-visible:not(:disabled) {
  outline: none;
  color: #79ff1d;
  border-style: solid;
  border-color: #79ff1d;
  background: rgba(121,255,29,0.12);
}

.target span {
  font: inherit;
  font-size: 6px;
  font-weight: 900;
}

.target_top_left {
  left: 3%;
  top: 4%;
}

.target_top_right {
  right: 3%;
  top: 4%;
}

.target_center {
  left: 34.5%;
  top: 31%;
}

.target_bottom_left {
  left: 3%;
  bottom: 4%;
}

.target_bottom_right {
  right: 3%;
  bottom: 4%;
}

.keeperWrap {
  position: absolute;
  z-index: 12;
  width: 82px;
  height: 102px;
  pointer-events: none;
  transition:
    left 0.42s steps(5, end),
    top 0.42s steps(5, end),
    bottom 0.42s steps(5, end),
    transform 0.42s steps(5, end);
}

.keeper_center {
  left: 50%;
  bottom: 0;
  transform: translateX(-50%);
}

.keeper_top_left {
  left: 18%;
  top: 18%;
  bottom: auto;
  transform: translate(-50%, -50%) rotate(-25deg);
}

.keeper_top_right {
  left: 82%;
  top: 18%;
  bottom: auto;
  transform: translate(-50%, -50%) rotate(25deg);
}

.keeper_bottom_left {
  left: 19%;
  bottom: 0;
  transform: translateX(-50%) rotate(-35deg);
}

.keeper_bottom_right {
  left: 81%;
  bottom: 0;
  transform: translateX(-50%) rotate(35deg);
}

.keeper {
  position: relative;
  width: 100%;
  height: 100%;
}

.keeperHead {
  position: absolute;
  left: 32px;
  top: 3px;
  width: 19px;
  height: 19px;
  background: #d29a68;
  box-shadow: 3px 3px 0 #4d2e1a;
}

.keeperBody {
  position: absolute;
  left: 25px;
  top: 27px;
  width: 34px;
  height: 40px;
  background: #6b737a;
  box-shadow: 4px 4px 0 #272c30;
}

.keeperArmLeft,
.keeperArmRight {
  position: absolute;
  top: 36px;
  width: 31px;
  height: 9px;
  background: #6b737a;
}

.keeperArmLeft {
  left: 0;
  transform: rotate(-18deg);
}

.keeperArmRight {
  right: 0;
  transform: rotate(18deg);
}

.keeperLegLeft,
.keeperLegRight {
  position: absolute;
  top: 66px;
  width: 11px;
  height: 27px;
  background: #e4e6e3;
}

.keeperLegLeft {
  left: 26px;
}

.keeperLegRight {
  right: 26px;
}

.keeperBootLeft,
.keeperBootRight {
  position: absolute;
  top: 92px;
  width: 16px;
  height: 7px;
  background: #101418;
}

.keeperBootLeft {
  left: 21px;
}

.keeperBootRight {
  right: 21px;
}

.penaltySpot {
  position: absolute;
  z-index: 3;
  left: 50%;
  top: 310px;
  width: 9px;
  height: 9px;
  background: #faf9ef;
  transform: translateX(-50%);
}

.ball {
  position: absolute;
  z-index: 30;
  width: 92px;
  height: 92px;
  border: 5px solid #171717;
  border-radius: 50%;
  background: #efefe8;
  box-shadow:
    6px 8px 0 rgba(0,0,0,0.26),
    inset -6px -6px 0 #b9b9b0;
  pointer-events: none;
  transition:
    left 0.48s steps(6, end),
    top 0.48s steps(6, end),
    width 0.48s steps(6, end),
    height 0.48s steps(6, end),
    transform 0.48s steps(6, end);
}

.ballPatchCenter,
.ballPatchOne,
.ballPatchTwo,
.ballPatchThree,
.ballPatchFour {
  position: absolute;
  width: 19px;
  height: 18px;
  background: #171717;
  clip-path: polygon(50% 0, 100% 35%, 82% 100%, 18% 100%, 0 35%);
}

.ballPatchCenter {
  left: 32px;
  top: 28px;
}

.ballPatchOne {
  left: 7px;
  top: 19px;
}

.ballPatchTwo {
  right: 7px;
  top: 19px;
}

.ballPatchThree {
  left: 14px;
  bottom: 10px;
}

.ballPatchFour {
  right: 14px;
  bottom: 10px;
}

.ballStart {
  left: 50%;
  top: 324px;
  transform: translateX(-50%);
}

.ball_top_left,
.ball_top_right,
.ball_center,
.ball_bottom_left,
.ball_bottom_right {
  width: 28px;
  height: 28px;
  border-width: 2px;
}

.ball_top_left span:not(.ballPatchCenter),
.ball_top_right span:not(.ballPatchCenter),
.ball_center span:not(.ballPatchCenter),
.ball_bottom_left span:not(.ballPatchCenter),
.ball_bottom_right span:not(.ballPatchCenter) {
  display: none;
}

.ball_top_left .ballPatchCenter,
.ball_top_right .ballPatchCenter,
.ball_center .ballPatchCenter,
.ball_bottom_left .ballPatchCenter,
.ball_bottom_right .ballPatchCenter {
  left: 8px;
  top: 7px;
  width: 8px;
  height: 8px;
}

.ball_top_left {
  left: 27%;
  top: 67px;
  transform: translate(-50%, -50%);
}

.ball_top_right {
  left: 73%;
  top: 67px;
  transform: translate(-50%, -50%);
}

.ball_center {
  left: 50%;
  top: 128px;
  transform: translate(-50%, -50%);
}

.ball_bottom_left {
  left: 28%;
  top: 195px;
  transform: translate(-50%, -50%);
}

.ball_bottom_right {
  left: 72%;
  top: 195px;
  transform: translate(-50%, -50%);
}

.actionPrompt {
  position: absolute;
  z-index: 35;
  left: 50%;
  bottom: 14px;
  transform: translateX(-50%);
  padding: 8px 12px;
  border: 3px solid #202930;
  background: rgba(7,10,13,0.92);
  color: #fff;
  font-size: 8px;
  font-weight: 900;
  white-space: nowrap;
}

.result,
.error {
  margin: 8px;
  padding: 11px 12px;
}

.result {
  display: flex;
  align-items: center;
  gap: 14px;
  border: 2px solid currentColor;
  background: #090d10;
}

.result strong {
  font-size: 16px;
}

.result b {
  font-size: 10px;
}

.result span {
  margin-left: auto;
  color: #9fa9b0;
  font-size: 6px;
}

.resultGoal {
  color: #79ff1d;
}

.resultSave {
  color: #ff5151;
}

.error {
  display: grid;
  gap: 4px;
  border: 3px solid #ff4e4e;
  background: #270909;
  color: #ff8a8a;
  font-size: 7px;
  font-weight: 900;
}

.attempts {
  display: grid;
  grid-template-columns: repeat(7, minmax(0, 1fr));
  gap: 5px;
  padding: 8px;
  border-top: 2px solid #252d33;
}

.attempts > div {
  min-height: 48px;
  display: grid;
  place-content: center;
  gap: 4px;
  border: 2px solid #303941;
  text-align: center;
}

.attempts span {
  color: #808b93;
  font-size: 6px;
  font-weight: 900;
}

.attempts strong {
  font-size: 7px;
}

.attemptGoal {
  border-color: #4e9f19 !important;
  background: #0d2109;
  color: #79ff1d;
}

.attemptSave {
  border-color: #c53737 !important;
  background: #1d0909;
  color: #ff5555;
}

.attemptPending {
  color: #717a81;
}

.sideRail {
  min-width: 0;
  display: grid;
  align-content: start;
  gap: 10px;
}

.card {
  min-width: 0;
  padding: 13px;
}

.card > span {
  color: #ffd329;
  font-size: 8px;
  font-weight: 900;
}

.statGrid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  margin-top: 10px;
  border: 1px solid #283138;
}

.statGrid div {
  min-height: 70px;
  display: grid;
  place-content: center;
  text-align: center;
}

.statGrid div:nth-child(even) {
  border-left: 1px solid #283138;
}

.statGrid div:nth-child(n + 3) {
  border-top: 1px solid #283138;
}

.statGrid small {
  color: #929da5;
  font-size: 6px;
  font-weight: 900;
}

.statGrid strong {
  margin-top: 5px;
  color: #79ff1d;
  font-size: 17px;
}

.rules {
  margin-top: 9px;
}

.rules p {
  display: flex;
  justify-content: space-between;
  gap: 8px;
  margin: 0;
  padding: 9px 0;
  border-bottom: 1px solid #283138;
}

.rules b {
  color: #b6bec4;
  font-size: 7px;
}

.rules strong {
  color: #79ff1d;
  font-size: 8px;
}

.prizes {
  display: grid;
  gap: 5px;
  margin-top: 9px;
}

.prizes div {
  display: grid;
  grid-template-columns: 36px minmax(0, 1fr);
  gap: 6px;
  align-items: center;
  padding: 8px;
  border: 1px solid #51451d;
  background: #151007;
}

.prizes strong {
  color: #ffd329;
  font-size: 7px;
}

.prizes span {
  color: #d7ca94;
  font-size: 6px;
  font-weight: 900;
  line-height: 1.4;
}

.leaderboard {
  min-width: 0;
  overflow: hidden;
}

.table {
  padding: 7px;
}

.tableHead,
.table > div:not(.tableHead) {
  display: grid;
  grid-template-columns: 48px minmax(140px, 1fr) 86px 74px 74px;
  align-items: center;
  min-height: 38px;
}

.tableHead {
  color: #8e99a1;
  font-size: 6px;
  font-weight: 900;
}

.table > div:not(.tableHead) {
  border-top: 1px solid #263037;
  color: #cbd0d4;
  font-size: 7px;
}

.table > div > strong {
  color: #ffd329;
}

.table > div > b {
  color: #79ff1d;
}

.currentPlayer {
  background: #0c1b09;
  box-shadow: inset 3px 0 0 #79ff1d;
}

.disclaimer {
  padding: 10px 12px;
  color: #8f999f;
  font-size: 6px;
  font-weight: 900;
}

.loading {
  min-height: 420px;
  display: grid;
  place-content: center;
  gap: 10px;
  border: 3px solid #313941;
  background: #06090c;
  color: #ffd329;
  text-align: center;
  font-size: 9px;
  font-weight: 900;
}

.loading span {
  max-width: 600px;
  color: #a3adb4;
  font-size: 7px;
}

.loading button {
  justify-self: center;
  padding: 8px 11px;
  border: 2px solid #4d991b;
  background: #10200d;
  color: #79ff1d;
  font: inherit;
  font-size: 7px;
}

@media (max-width: 1080px) {
  .gameHeader {
    grid-template-columns: 1fr;
  }

  .contentGrid {
    grid-template-columns: 1fr;
  }

  .sideRail {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
}

@media (max-width: 720px) {
  .gameHeader {
    padding: 13px;
  }

  .headerStats {
    grid-template-columns: 1fr;
  }

  .headerStats div + div {
    border-left: 0;
    border-top: 1px solid #313a41;
  }

  .scene {
    height: 460px;
  }

  .goal {
    width: 86%;
    height: 190px;
  }

  .crowd {
    height: 118px;
  }

  .pitch {
    inset: 156px 0 0;
  }

  .ball {
    width: 72px;
    height: 72px;
  }

  .ballStart {
    top: 300px;
  }

  .sideRail {
    grid-template-columns: 1fr;
  }

  .attempts {
    grid-template-columns: repeat(4, 1fr);
  }

  .result {
    align-items: flex-start;
    flex-direction: column;
  }

  .result span {
    margin-left: 0;
  }

  .table {
    overflow-x: auto;
  }

  .tableHead,
  .table > div:not(.tableHead) {
    min-width: 560px;
  }
}
