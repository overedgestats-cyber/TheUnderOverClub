.page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  background:
    radial-gradient(circle at 82% 8%, rgba(61, 255, 139, 0.08), transparent 24rem),
    #050807;
  color: #f1f6f3;
}

.gridOverlay {
  position: fixed;
  inset: 0;
  pointer-events: none;
  opacity: 0.16;
  background-image:
    linear-gradient(rgba(255,255,255,.04) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,.04) 1px, transparent 1px);
  background-size: 16px 16px;
  mask-image: linear-gradient(to bottom, black, transparent 80%);
}

.shell {
  position: relative;
  width: min(1180px, calc(100% - 32px));
  margin: 0 auto;
  padding: 28px 0 44px;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  padding: 14px 16px;
  border: 1px solid #253029;
  background: rgba(8, 13, 10, .96);
  box-shadow: 5px 5px 0 #020302;
}

.brand {
  color: #69f39b;
  text-decoration: none;
  font-size: 12px;
  font-weight: 900;
  letter-spacing: .14em;
}

.nav {
  display: flex;
  align-items: center;
  gap: 8px;
}

.navLink,
.navActive {
  padding: 8px 10px;
  color: #77827c;
  text-decoration: none;
  font-size: 11px;
  font-weight: 900;
  letter-spacing: .1em;
}

.navActive {
  color: #68f39b;
  background: #0d1e15;
  border: 1px solid #24593b;
}

.hero {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24px;
  margin-top: 22px;
  padding: 28px;
  border: 1px solid #2a3730;
  background: linear-gradient(135deg, #102018, #090d0b 72%);
  box-shadow: 8px 8px 0 #020302;
}

.eyebrow,
.rank,
.competition,
.kickoff,
.selection span,
.metrics span,
.infoStrip span,
.datePanel span {
  font-size: 10px;
  font-weight: 900;
  letter-spacing: .14em;
  text-transform: uppercase;
}

.eyebrow,
.rank {
  color: #68f39b;
}

.hero h1 {
  margin: 8px 0;
  font-size: clamp(38px, 7vw, 70px);
  line-height: .95;
  letter-spacing: -.045em;
}

.hero p {
  max-width: 620px;
  margin: 0;
  color: #8c9991;
  line-height: 1.55;
}

.datePanel {
  flex: 0 0 auto;
  min-width: 190px;
  padding: 14px;
  border: 1px solid #31503d;
  background: #09130d;
}

.datePanel span {
  display: block;
  margin-bottom: 7px;
  color: #68f39b;
}

.datePanel strong {
  font-size: 14px;
}

.pickGrid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18px;
  margin-top: 24px;
}

.pickCard {
  position: relative;
  min-width: 0;
  border: 1px solid #2b3831;
  background: linear-gradient(180deg, #0c120f, #080c0a);
  box-shadow: 7px 7px 0 #020302;
}

.pickCard::before {
  content: "";
  position: absolute;
  top: -1px;
  left: -1px;
  width: 72px;
  height: 3px;
  background: #68f39b;
}

.pickCardTop {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12px;
  padding: 18px 18px 0;
}

.rank,
.competition {
  display: block;
}

.competition {
  margin-top: 6px;
  color: #6e7b73;
}

.status {
  padding: 8px 10px;
  border: 1px solid;
  font-size: 10px;
  font-weight: 900;
  letter-spacing: .1em;
}

.statusPending {
  color: #e0d16e;
  border-color: #675d25;
  background: #171407;
}

.statusWon {
  color: #71f49e;
  border-color: #2f7549;
  background: #0d1c13;
}

.statusLost {
  color: #ff8080;
  border-color: #713434;
  background: #1d0c0c;
}

.statusVoid {
  color: #b4beb8;
  border-color: #414b45;
  background: #111513;
}

.fixture {
  padding: 26px 18px;
}

.kickoff {
  display: block;
  margin-bottom: 14px;
  color: #78857d;
}

.fixture h2 {
  margin: 0;
  overflow-wrap: anywhere;
  font-size: clamp(22px, 4vw, 32px);
  line-height: 1.05;
}

.vs {
  display: block;
  margin: 7px 0;
  color: #59645e;
  font-size: 10px;
  font-weight: 900;
  letter-spacing: .14em;
}

.finalScore {
  margin-top: 16px;
  font-size: 26px;
  font-weight: 900;
  color: #68f39b;
}

.selection {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  margin: 0 18px;
  padding: 15px 16px;
  border: 1px solid #346348;
  background: #0c1b12;
}

.selection span {
  color: #738078;
}

.selection strong {
  color: #73f6a1;
  font-size: 24px;
}

.metrics {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  margin-top: 18px;
  border-top: 1px solid #1f2924;
  border-bottom: 1px solid #1f2924;
}

.metrics div {
  padding: 16px 18px;
}

.metrics div + div {
  border-left: 1px solid #1f2924;
}

.metrics span {
  display: block;
  margin-bottom: 7px;
  color: #657169;
}

.metrics strong {
  font-size: 22px;
}

.cardFooter {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  padding: 14px 18px;
  color: #68746d;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: .08em;
}

.empty {
  display: flex;
  align-items: center;
  gap: 18px;
  margin-top: 24px;
  padding: 28px;
  border: 1px solid #28332d;
  background: #090d0b;
  box-shadow: 6px 6px 0 #020302;
}

.emptyPixel {
  display: grid;
  place-items: center;
  width: 58px;
  height: 58px;
  border: 1px solid #31503d;
  background: #0c1710;
  font-size: 26px;
}

.empty h2 {
  margin: 0 0 7px;
}

.empty p {
  margin: 0;
  color: #7d8982;
}

.infoStrip {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  margin-top: 22px;
  border: 1px solid #242f29;
  background: #080c0a;
}

.infoStrip div {
  padding: 16px 18px;
}

.infoStrip div + div {
  border-left: 1px solid #242f29;
}

.infoStrip span {
  display: block;
  margin-bottom: 7px;
  color: #657169;
}

.infoStrip strong {
  color: #dbe4df;
  font-size: 13px;
}

.footer {
  display: flex;
  justify-content: space-between;
  gap: 24px;
  margin-top: 24px;
  padding-top: 18px;
  border-top: 1px solid #202923;
  color: #77837c;
  font-size: 12px;
  line-height: 1.55;
}

.footer p {
  max-width: 760px;
  margin: 0;
}

.footer a {
  flex: 0 0 auto;
  color: #68f39b;
  text-decoration: none;
  font-weight: 900;
}

@media (max-width: 760px) {
  .shell {
    width: min(100% - 18px, 1180px);
    padding-top: 12px;
  }

  .brand {
    max-width: 170px;
  }

  .hero {
    align-items: flex-start;
    flex-direction: column;
    padding: 22px;
  }

  .datePanel {
    min-width: 0;
  }

  .pickGrid {
    grid-template-columns: 1fr;
  }

  .infoStrip {
    grid-template-columns: 1fr;
  }

  .infoStrip div + div {
    border-left: 0;
    border-top: 1px solid #242f29;
  }

  .footer {
    flex-direction: column;
  }
}

@media (max-width: 460px) {
  .topbar {
    align-items: flex-start;
    flex-direction: column;
  }

  .metrics {
    grid-template-columns: 1fr;
  }

  .metrics div + div {
    border-left: 0;
    border-top: 1px solid #1f2924;
  }

  .cardFooter {
    flex-direction: column;
  }

  .selection {
    align-items: flex-start;
    flex-direction: column;
  }
}
