.page {
  --bg: #030806;
  --panel: #07100b;
  --line: #20392b;
  --line-strong: #2c6846;
  --green: #6dff9e;
  --white: #f1f5f2;
  --muted: #87958d;
  min-height: 100vh;
  background:
    radial-gradient(
      circle at 70% 0%,
      rgba(29, 116, 61, 0.11),
      transparent 34%
    ),
    var(--bg);
  color: var(--white);
}

.shell {
  width: min(1180px, calc(100% - 32px));
  margin: 0 auto;
  padding: 24px 0 40px;
}

.header {
  min-height: 70px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  padding: 0 20px;
  border: 1px solid var(--line);
  background: rgba(5, 13, 9, 0.96);
  box-shadow: 7px 7px 0 rgba(0,0,0,0.42);
}

.brand {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  color: var(--green);
  text-decoration: none;
  font-size: 12px;
  font-weight: 900;
  letter-spacing: 0.12em;
}

.brandMark {
  width: 32px;
  height: 32px;
  display: grid;
  place-items: center;
  border: 1px solid var(--line-strong);
  background: #0a2214;
  font-size: 9px;
}

.nav {
  display: flex;
  gap: 4px;
}

.nav a {
  padding: 11px 12px;
  color: var(--muted);
  text-decoration: none;
  font-size: 9px;
  font-weight: 900;
  letter-spacing: 0.08em;
}

.nav a:hover {
  color: var(--green);
}

.hero {
  margin-top: 24px;
  padding: 36px;
  border: 1px solid var(--line);
  background: #07100b;
  box-shadow: 7px 7px 0 rgba(0,0,0,0.38);
}

.eyebrow {
  color: var(--green);
  font-size: 10px;
  font-weight: 900;
  letter-spacing: 0.12em;
}

.hero h1 {
  margin: 12px 0 8px;
  font-size: clamp(42px, 6vw, 74px);
  font-weight: 500;
  letter-spacing: -0.045em;
}

.hero p {
  margin: 0;
  color: var(--muted);
  font-size: 12px;
}

.content {
  margin-top: 18px;
  padding: 34px 36px;
  border: 1px solid var(--line);
  background: rgba(5, 13, 9, 0.96);
  box-shadow: 7px 7px 0 rgba(0,0,0,0.38);
}

.content h2 {
  margin: 34px 0 10px;
  color: var(--green);
  font-size: 18px;
  letter-spacing: 0.02em;
}

.content h2:first-child {
  margin-top: 0;
}

.content h3 {
  margin: 24px 0 8px;
  font-size: 14px;
}

.content p,
.content li {
  color: #a0ada5;
  font-size: 14px;
  line-height: 1.75;
}

.content ul {
  padding-left: 20px;
}

.content a {
  color: var(--green);
}

.notice {
  margin: 22px 0;
  padding: 18px;
  border: 1px solid var(--line-strong);
  background: #0a1b11;
  color: #b7c6bc;
}

.footer {
  display: flex;
  justify-content: space-between;
  gap: 24px;
  margin-top: 22px;
  padding: 24px 4px;
  border-top: 1px solid var(--line);
}

.footer > div {
  display: grid;
  gap: 7px;
}

.footer strong {
  color: var(--green);
  font-size: 10px;
  letter-spacing: 0.1em;
}

.footer span {
  color: var(--muted);
  font-size: 10px;
}

.footer nav {
  display: flex;
  flex-wrap: wrap;
  gap: 16px;
}

.footer a {
  color: #7f8e85;
  text-decoration: none;
  font-size: 10px;
  font-weight: 900;
}

@media (max-width: 760px) {
  .shell {
    width: calc(100% - 16px);
    padding-top: 8px;
  }

  .header {
    min-height: 56px;
    padding: 10px 12px;
  }

  .nav {
    display: none;
  }

  .hero,
  .content {
    padding: 22px 20px;
  }

  .hero h1 {
    font-size: 44px;
  }

  .content p,
  .content li {
    font-size: 13px;
  }

  .footer {
    flex-direction: column;
  }
}
