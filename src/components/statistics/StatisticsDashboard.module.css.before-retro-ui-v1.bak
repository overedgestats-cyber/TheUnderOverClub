.page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  background:
    radial-gradient(circle at top right, rgba(44, 255, 140, 0.07), transparent 28rem),
    linear-gradient(180deg, #070b0d 0%, #050708 100%);
  color: #f4f7f5;
}

.pixelGrid {
  pointer-events: none;
  position: fixed;
  inset: 0;
  opacity: 0.16;
  background-image:
    linear-gradient(rgba(255,255,255,0.035) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,0.035) 1px, transparent 1px);
  background-size: 16px 16px;
  mask-image: linear-gradient(to bottom, black, transparent 70%);
}

.shell {
  position: relative;
  width: min(1180px, calc(100% - 32px));
  margin: 0 auto;
  padding: 56px 0 48px;
}

.hero {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24px;
  padding: 30px;
  border: 1px solid #24302a;
  background:
    linear-gradient(135deg, rgba(30, 45, 37, 0.82), rgba(9, 13, 11, 0.96));
  box-shadow:
    8px 8px 0 #020303,
    inset 0 0 0 1px rgba(255,255,255,0.025);
}

.kicker,
.eyebrow,
.metricLabel {
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.16em;
  text-transform: uppercase;
}

.kicker {
  color: #55f08f;
}

.hero h1 {
  margin: 10px 0 6px;
  font-size: clamp(38px, 7vw, 72px);
  line-height: 0.95;
  letter-spacing: -0.045em;
}

.hero p {
  max-width: 560px;
  margin: 0;
  color: #98a39d;
  font-size: 15px;
}

.liveBadge {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  flex: 0 0 auto;
  padding: 10px 12px;
  border: 1px solid #30483b;
  background: #09120d;
  color: #79f3a5;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.08em;
}

.liveDot {
  width: 8px;
  height: 8px;
  background: #55f08f;
  box-shadow: 0 0 14px rgba(85, 240, 143, 0.72);
}

.tabs {
  display: flex;
  gap: 8px;
  margin: 30px 0 22px;
  overflow-x: auto;
  scrollbar-width: none;
}

.tabs::-webkit-scrollbar {
  display: none;
}

.tab,
.tabActive {
  min-width: max-content;
  border: 1px solid #26312b;
  padding: 12px 16px;
  background: #0b100d;
  color: #88938d;
  cursor: pointer;
  font: inherit;
  font-size: 12px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

.tab:hover {
  color: #eaf2ed;
  border-color: #405047;
}

.tabActive {
  border-color: #55f08f;
  background: #102319;
  color: #7af4a5;
  box-shadow: 4px 4px 0 #020303;
}

.section {
  margin-top: 18px;
}

.sectionHeader,
.panelHeading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
}

.sectionHeader {
  margin-bottom: 16px;
}

.sectionHeader h2,
.panelHeading h3 {
  margin: 4px 0 0;
}

.sectionHeader h2 {
  font-size: 28px;
}

.panelHeading h3 {
  font-size: 18px;
}

.eyebrow,
.metricLabel {
  color: #6e7a73;
}

.recordBadge {
  border: 1px solid #28352e;
  padding: 9px 11px;
  background: #0a0f0c;
  color: #aeb9b3;
  font-size: 12px;
  font-weight: 800;
}

.metricGrid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12px;
}

.metricCard {
  min-height: 134px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: 10px;
  padding: 18px;
  border: 1px solid #222c27;
  background: rgba(11, 16, 13, 0.94);
  box-shadow: 5px 5px 0 #020303;
}

.metricCardAccent {
  border-color: #2f7650;
  background:
    linear-gradient(145deg, #102319, #0a0e0c);
}

.metricValue {
  font-size: 32px;
  line-height: 1;
  letter-spacing: -0.03em;
}

.metricSub {
  color: #6f7a74;
  font-size: 12px;
}

.emptyState,
.panel,
.miniRecord {
  border: 1px solid #232e28;
  background: rgba(9, 13, 11, 0.94);
  box-shadow: 5px 5px 0 #020303;
}

.emptyState {
  display: flex;
  gap: 16px;
  align-items: center;
  margin-top: 14px;
  padding: 20px;
}

.emptyIcon {
  display: grid;
  place-items: center;
  width: 48px;
  height: 48px;
  border: 1px solid #31443a;
  background: #0f1713;
  color: #55f08f;
  font-size: 24px;
}

.emptyState strong {
  display: block;
  margin-bottom: 5px;
}

.emptyState p,
.panelEmpty,
.miniRecord p,
.footer {
  color: #7f8a84;
  font-size: 13px;
}

.emptyState p,
.miniRecord p {
  margin: 0;
}

.panel {
  margin-top: 18px;
  padding: 20px;
}

.panelHeading {
  margin-bottom: 16px;
}

.marketTable {
  display: grid;
  gap: 6px;
}

.tableHeader,
.tableRow {
  display: grid;
  grid-template-columns: minmax(150px, 1.5fr) repeat(4, minmax(70px, 1fr));
  gap: 12px;
  align-items: center;
  padding: 12px 14px;
}

.tableHeader {
  color: #66716b;
  border-bottom: 1px solid #27312c;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.tableRow {
  border: 1px solid #1c2521;
  background: #0a0e0c;
  font-size: 13px;
}

.tableRow strong {
  color: #dce5df;
}

.tableRow span {
  color: #a4afa9;
}

.panelEmpty {
  padding: 20px 0 4px;
}

.splitGrid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14px;
  margin-top: 18px;
}

.miniRecord {
  padding: 22px;
}

.miniRecord strong {
  display: block;
  margin: 12px 0 6px;
  font-size: 38px;
  color: #f0f5f2;
}

.footer {
  display: flex;
  justify-content: space-between;
  gap: 20px;
  margin-top: 34px;
  padding-top: 20px;
  border-top: 1px solid #1e2723;
}

.footer p {
  max-width: 700px;
  margin: 0;
}

.footer span {
  white-space: nowrap;
}

@media (max-width: 820px) {
  .shell {
    width: min(100% - 20px, 1180px);
    padding: 22px 0 34px;
  }

  .hero {
    align-items: flex-start;
    flex-direction: column;
    padding: 22px;
  }

  .liveBadge {
    align-self: flex-start;
  }

  .metricGrid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .tableHeader,
  .tableRow {
    grid-template-columns: minmax(120px, 1.5fr) repeat(4, minmax(64px, 1fr));
    min-width: 620px;
  }

  .marketTable {
    overflow-x: auto;
  }

  .footer {
    flex-direction: column;
  }

  .footer span {
    white-space: normal;
  }
}

@media (max-width: 520px) {
  .metricGrid,
  .splitGrid {
    grid-template-columns: 1fr;
  }

  .metricCard {
    min-height: 116px;
  }

  .sectionHeader {
    align-items: flex-start;
  }

  .recordBadge {
    margin-top: 2px;
  }
}
