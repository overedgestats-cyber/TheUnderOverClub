.app {
  --retro-bg: #05070a;
  --retro-panel: #080c10;
  --retro-panel-2: #0b1015;
  --retro-line: #2b3037;
  --retro-line-soft: #191e24;
  --retro-green: #7ed321;
  --retro-green-bright: #8cff2c;
  --retro-red: #ff2b2f;
  --retro-yellow: #ffc928;
  --retro-blue: #2b9cff;
  --retro-purple: #c34cff;
  --retro-orange: #ff8a1e;
  --retro-cream: #f4efe4;
  --retro-muted: #92979d;

  position: relative;
  z-index: 0;
  display: grid;
  grid-template-columns: 252px minmax(0, 1fr);
  gap: 8px;
  min-height: 100vh;
  padding: 8px;
  box-sizing: border-box;
  overflow-x: hidden;
  background: #020304;
  color: var(--retro-cream);
  font-family: "Lucida Console", "Courier New", monospace;
}

.app,
.app *,
.app *::before,
.app *::after {
  box-sizing: border-box;
}

.pixelBackdrop {
  position: fixed;
  z-index: -1;
  inset: 0;
  pointer-events: none;
  background:
    linear-gradient(rgba(255,255,255,0.015) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,0.015) 1px, transparent 1px),
    radial-gradient(circle at 70% 0%, rgba(19, 62, 108, 0.13), transparent 35%),
    #020304;
  background-size: 8px 8px, 8px 8px, auto, auto;
}

.sidebar {
  position: sticky;
  top: 8px;
  align-self: start;
  display: flex;
  flex-direction: column;
  height: calc(100vh - 16px);
  border: 3px solid var(--retro-line);
  background: linear-gradient(to bottom, #080b0e, #050709);
  box-shadow: inset 0 0 0 2px #030405, 4px 4px 0 #000;
}

.logoLink {
  display: block;
  padding: 12px 13px 10px;
  border-bottom: 3px solid var(--retro-line);
  text-decoration: none;
}

.logo {
  display: block;
  width: 100%;
  height: auto;
  image-rendering: pixelated;
}

.sideNav {
  display: grid;
  padding: 8px 0;
}

.navItem,
.navItemActive {
  position: relative;
  display: grid;
  grid-template-columns: 38px 1fr 16px;
  align-items: center;
  min-height: 58px;
  padding: 0 14px;
  border: 2px solid transparent;
  border-bottom-color: var(--retro-line-soft);
  color: #a5a8ad;
  text-decoration: none;
  font-size: 13px;
  font-weight: 900;
  letter-spacing: 0.07em;
  text-shadow: 2px 2px 0 #000;
}

.navItem:hover {
  color: var(--retro-cream);
  background: #0b0f13;
}

.navItemActive {
  margin: 3px 7px;
  min-height: 54px;
  border-color: #4b8d19;
  background: linear-gradient(90deg, rgba(126,211,33,0.17), rgba(126,211,33,0.035));
  color: var(--retro-green-bright);
  box-shadow: inset 0 0 0 1px #14200f, 3px 3px 0 #000;
}

.navIcon {
  display: grid;
  place-items: center;
  width: 27px;
  height: 27px;
  color: currentColor;
  font-size: 22px;
  line-height: 1;
}

.navArrow {
  justify-self: end;
  color: var(--retro-yellow);
  font-size: 11px;
}

.upgradePanel,
.memberPanel {
  margin: auto 10px 12px;
  padding: 16px 12px;
  border: 2px solid #9c281c;
  background: linear-gradient(180deg, #160d0c, #090708);
  text-align: center;
  box-shadow: inset 0 0 0 2px #050505, 3px 3px 0 #000;
}

.memberPanel {
  border-color: #447d1d;
  background: linear-gradient(180deg, #0d170b, #070907);
}

.upgradeIcon {
  margin-bottom: 8px;
  color: var(--retro-yellow);
  font-size: 44px;
  line-height: 1;
  text-shadow: 3px 3px 0 #7a4c00;
}

.upgradePanel strong,
.memberPanel strong {
  display: block;
  color: var(--retro-yellow);
  font-size: 14px;
  letter-spacing: 0.08em;
}

.memberPanel strong {
  color: var(--retro-green-bright);
}

.upgradePanel p,
.memberPanel p {
  margin: 10px 0 14px;
  color: #a7a7a7;
  font-size: 10px;
  line-height: 1.55;
}

.upgradePanel a,
.memberPanel a {
  display: block;
  padding: 11px 8px;
  border: 2px solid #ffc928;
  background: #f2b916;
  color: #120d00;
  text-decoration: none;
  font-size: 11px;
  font-weight: 900;
  letter-spacing: 0.08em;
  box-shadow: inset 0 -4px 0 #c98108, 3px 3px 0 #000;
}

.memberPanel a {
  border-color: var(--retro-green);
  background: #1f4b12;
  color: var(--retro-green-bright);
  box-shadow: inset 0 -4px 0 #102a09, 3px 3px 0 #000;
}

.main {
  min-width: 0;
  display: grid;
  grid-template-rows: auto 1fr auto;
  gap: 8px;
}

.hud {
  min-height: 76px;
  display: grid;
  grid-template-columns:
    repeat(4, minmax(128px, 1fr))
    minmax(210px, 1.2fr);
  align-items: stretch;
  border: 3px solid var(--retro-line);
  background: #05080b;
  box-shadow: inset 0 0 0 2px #020304, 4px 4px 0 #000;
}

.hudStat,
.hudMember {
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 11px;
  padding: 9px 14px;
  border-right: 2px solid var(--retro-line-soft);
}

.hudStat > span {
  flex: 0 0 auto;
  font-size: 25px;
  text-shadow: 2px 2px 0 #000;
}

.hudStat div,
.hudMember > div {
  min-width: 0;
}

.hudStat small,
.hudMember small {
  display: block;
  color: #b0b1b3;
  font-size: 8px;
  font-style: normal;
  font-weight: 900;
  letter-spacing: 0.11em;
}

.hudStat strong,
.hudMember strong {
  display: block;
  margin-top: 3px;
  font-size: 17px;
  line-height: 1;
  white-space: nowrap;
}

.hudStat em {
  display: block;
  margin-top: 5px;
  overflow: hidden;
  color: #666d75;
  font-size: 7px;
  font-style: normal;
  font-weight: 700;
  letter-spacing: 0.07em;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hudIconGreen { color: var(--retro-green); }
.hudIconGold { color: var(--retro-yellow); }
.hudIconBlue { color: var(--retro-blue); }
.hudIconPurple { color: var(--retro-purple); }

.hudStat:nth-child(1) strong,
.hudStat:nth-child(2) strong {
  color: var(--retro-green-bright);
}

.hudStat:nth-child(3) strong { color: var(--retro-blue); }
.hudStat:nth-child(4) strong { color: var(--retro-purple); }

.hudMember {
  border-right: 0;
  justify-content: center;
}

.memberCoin {
  width: 34px;
  height: 34px;
  display: grid;
  place-items: center;
  flex: 0 0 auto;
  border: 3px solid #f9c121;
  background: #7f5700;
  color: #fff3a6;
  font-size: 17px;
  font-weight: 900;
  box-shadow: inset 0 0 0 2px #3b2600, 2px 2px 0 #000;
}

.hudMember strong {
  overflow: hidden;
  color: var(--retro-yellow);
  font-size: 12px;
  text-overflow: ellipsis;
}

.userButton {
  margin-left: auto;
}

.signInLink {
  margin-left: auto;
  padding: 9px 10px;
  border: 2px solid #497c21;
  background: #10200e;
  color: var(--retro-green-bright);
  text-decoration: none;
  font-size: 9px;
  font-weight: 900;
}

.content { min-width: 0; }

.footer {
  min-height: 74px;
  display: grid;
  grid-template-columns: 1fr 1fr 1fr auto;
  align-items: center;
  gap: 18px;
  padding: 10px 20px;
  border: 3px solid var(--retro-line);
  background: #05080b;
  box-shadow: inset 0 0 0 2px #020304, 4px 4px 0 #000;
}

.footer > div {
  display: flex;
  align-items: center;
  gap: 12px;
}

.footer p {
  margin: 0;
  color: #777e86;
  font-size: 8px;
  line-height: 1.5;
  letter-spacing: 0.05em;
}

.footer strong { color: #a5a9ae; }

.footerShield,
.footerGamepad {
  color: var(--retro-cream);
  font-size: 27px;
}

.footer nav {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 10px;
}

.footer a {
  color: #6f7880;
  text-decoration: none;
  font-size: 7px;
  font-weight: 900;
}

.footer a:hover {
  color: var(--retro-green-bright);
}

.mobileNav { display: none; }

@media (max-width: 1180px) {
  .app { grid-template-columns: 215px minmax(0, 1fr); }

  .hud {
    grid-template-columns:
      repeat(4, minmax(105px, 1fr))
      minmax(180px, 1.1fr);
  }

  .hudStat {
    padding-left: 9px;
    padding-right: 9px;
  }

  .hudStat > span { font-size: 20px; }
  .hudStat strong { font-size: 14px; }
  .hudMember strong { font-size: 10px; }
}

@media (max-width: 900px) {
  .app {
    display: block;
    padding: 6px 6px 78px;
  }

  .sidebar { display: none; }

  .main { display: block; }

  .hud {
    display: flex;
    min-height: 68px;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .hud::-webkit-scrollbar { display: none; }

  .hudStat,
  .hudMember {
    min-width: 145px;
    flex: 0 0 auto;
  }

  .hudMember { min-width: 185px; }

  .footer {
    margin-top: 8px;
    grid-template-columns: 1fr 1fr;
  }

  .footer nav {
    grid-column: 1 / -1;
    justify-content: flex-start;
  }

  .mobileNav {
    position: fixed;
    z-index: 100;
    left: 6px;
    right: 6px;
    bottom: 6px;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    min-height: 64px;
    border: 3px solid var(--retro-line);
    background: rgba(4, 7, 9, 0.98);
    box-shadow: inset 0 0 0 2px #020304, 4px 4px 0 #000;
  }

  .mobileNav .navItem,
  .mobileNav .navItemActive {
    display: grid;
    grid-template-columns: 1fr;
    grid-template-rows: 25px auto;
    place-items: center;
    min-height: 58px;
    margin: 0;
    padding: 5px 2px;
    border: 0;
    border-right: 1px solid var(--retro-line-soft);
    background: transparent;
    font-size: 7px;
    text-align: center;
    box-shadow: none;
  }

  .mobileNav .navItemActive {
    color: var(--retro-green-bright);
    background: #0b170d;
  }

  .mobileNav .navIcon {
    width: auto;
    height: auto;
    font-size: 18px;
  }

  .mobileNav .navArrow { display: none; }
}

@media (max-width: 560px) {
  .hudStat { min-width: 128px; }
  .hudMember { min-width: 170px; }
  .hudStat em { display: none; }

  .footer { grid-template-columns: 1fr; }
  .footer nav { grid-column: auto; }
  .footer > div:nth-child(3) { display: none; }
}
